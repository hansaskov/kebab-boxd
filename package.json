{
  "name": "kebab-boxd",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "description": "KEBAB MMMMMMMMMMHH",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sst:dev": "sst dev",
    "sst:deploy": "sst deploy --stage production",
    "db:generate": "drizzle-kit generate",
    "check": "tsc --noEmit --runExternalCode",
    "test": "vitest run",
    "test:e2e": "E2E=1 vitest run src/tests/e2e",
    "bench:pages": "node tools/page-latency/run.ts",
    "bench:live": "node tools/page-latency/live.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.8",
    "@lucide/astro": "^1.73.0",
    "astro": "7.4.12",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "drizzle-seed": "1.0.0-rc.5",
    "sst": "^4.17.2"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "0.2.0",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@oxlint/plugins": "1.94.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.3-beta",
    "oxlint": "^1.94.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "7.1.0-beta",
    "vitest": "^5.1.0"
  },
  "devEngines": {
