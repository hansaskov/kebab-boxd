{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "paths": {
      "@src/*": ["./src/*"],
    }
  },
  "contentMappers": [
    { "package": "@astrojs/ts-content-mapper", "extensions": [".astro"] }
  ],
  "exclude": ["dist", "tools", ".sst", "sst.config.ts"]
}
