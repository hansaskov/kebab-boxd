---
import BaseLayout from "@src/layouts/BaseLayout.astro";
import type { Toast } from "@src/components/Toast.astro";

const errorToasts: Record<string, Toast> = {
	expired: {
		variant: "error",
		title: "Sign-in expired",
		text: "Please sign in again.",
	},
	failed: {
		variant: "error",
		title: "Sign-in failed",
		text: "Google could not confirm your account. Please try again.",
	},
	banned: {
		variant: "error",
		title: "Account banned",
		text: "An admin has banned this account, so you cannot sign in.",
	},
};

const noticeToasts: Record<string, Toast> = {
	"account-deleted": {
		title: "Account deleted",
		text: "Your account and your data are deleted.",
	},
};

const error = Astro.url.searchParams.get("error");
const notice = Astro.url.searchParams.get("notice");
const toast = (error ? errorToasts[error] : undefined) ?? (notice ? noticeToasts[notice] : undefined);
---

<BaseLayout
	title="Login"
	description="Login page"
	prefetchUrls={["/", "/privacy"]}
	toast={toast}
>
	<a class="btn btn-primary btn-md" href="/api/google">Sign in with Google</a>
</BaseLayout>
