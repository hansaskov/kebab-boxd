---
import BaseLayout from "@src/layouts/BaseLayout.astro";
import GoogleSignInButton from "@src/components/GoogleSignInButton.astro";
import { signInReasonMessages, signInReasons } from "@src/data/login-reasons";
import { feedHref } from "@src/hrefs";
import { parseReturnPath } from "@src/validation/return-path";

const returnPath = parseReturnPath(Astro.url.searchParams.get("next"));

if (Astro.locals.session) {
  return Astro.redirect(returnPath ?? feedHref);
}

// A user who is sent here, rather than coming on their own, is told why.
const reason = signInReasons.find((option) => option === Astro.url.searchParams.get("reason"));
const message = reason ? signInReasonMessages[reason] : undefined;
const toast = message && { title: message.title, text: message.text, variant: message.isError ? ("error" as const) : undefined };
---

<BaseLayout title="Login" description="Log in to Kebab Boxd with your Google account." prefetchUrls={["/privacy"]} toast={toast}>
  <link slot="head" rel="preload" href="/fonts/google-sans-medium-latin.woff2" as="font" type="font/woff2" crossorigin />

  <div class="flex flex-col items-center gap-8 pt-12 text-center sm:pt-20">
    <h1>Log in to Kebab Boxd</h1>
    <GoogleSignInButton returnPath={returnPath} />
  </div>
</BaseLayout>
