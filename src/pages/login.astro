---
import { Heart, MapPin, Star, StarHalf, UsersRound } from "@lucide/astro";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import Avatar from "@src/components/Avatar.astro";
import type { Toast } from "@src/components/Toast.astro";
import { googleSignInHref, signInErrors, type SignInError } from "@src/hrefs";
import { parseReturnPath } from "@src/validation/return-path";

const returnPath = parseReturnPath(Astro.url.searchParams.get("next"));

if (Astro.locals.session) {
	return Astro.redirect(returnPath ?? "/");
}

const errorToasts: Record<SignInError, Toast> = {
	expired: {
		variant: "error",
		title: "Sign-in expired",
		text: "Please sign in again.",
	},
	failed: {
		variant: "error",
		title: "Sign-in failed",
		text: "Google could not confirm your account. Please try again.",
	},
	banned: {
		variant: "error",
		title: "Account banned",
		text: "An admin has banned this account, so you cannot sign in.",
	},
};

const noticeToasts: Record<string, Toast> = {
	"account-deleted": {
		title: "Account deleted",
		text: "Your account and your data are deleted.",
	},
};

const error = signInErrors.find((option) => option === Astro.url.searchParams.get("error"));
const notice = Astro.url.searchParams.get("notice");
const toast = (error ? errorToasts[error] : undefined) ?? (notice && Object.hasOwn(noticeToasts, notice) ? noticeToasts[notice] : undefined);
const googleHref = googleSignInHref(returnPath);

const features = [
	{
		icon: Star,
		title: "Rate every visit",
		text: "Give a restaurant 1 to 5 stars each time you eat there. Each person counts once in its rating.",
	},
	{
		icon: MapPin,
		title: "Find places near you",
		text: "Open the map to see the restaurants around you and how people rate them.",
	},
	{
		icon: Heart,
		title: "Keep your lists",
		text: "Save the places you love as favorites, and the places you want to try on your bucket list.",
	},
	{
		icon: UsersRound,
		title: "Follow your friends",
		text: "Your feed shows the reviews of the people you follow.",
	},
];
---

<BaseLayout
	title="Kebab Boxd"
	description="Review kebab restaurants, keep lists of the places you love, and follow your friends."
	prefetchUrls={["/privacy"]}
	toast={toast}
>
	<section class="grid items-center gap-12 pt-6 pb-section md:grid-cols-[1.15fr_1fr] md:pt-12">
		<div class="text-center md:text-left">
			<h1 class="text-4xl leading-[1.08] font-semibold tracking-tight text-balance sm:text-5xl">
				Every kebab, rated by the people who eat them.
			</h1>
			<p class="t-lead mx-auto mt-5 max-w-[34ch] text-balance text-fg-muted md:mx-0 md:text-pretty">
				Review the restaurants you visit, find the best places near you, and see where your friends eat.
			</p>
			<a class="btn btn-primary btn-md mt-8" href={googleHref}>Sign in with Google</a>
		</div>

		<div class="relative mx-auto w-full max-w-sm select-none md:mx-0" aria-hidden="true">
			<div class="ml-auto w-[85%] translate-x-2 rotate-3 rounded-box border border-line bg-surface px-4 py-3.5 shadow-lift">
				<div class="flex items-center justify-between gap-3">
					<p class="field-label">Mangal Express</p>
					<span class="t-body-sm flex items-center gap-1 text-fg-muted">
						<Star class="text-brand-text" size={14} fill="currentColor" />4.6
					</span>
				</div>
				<p class="t-body-sm text-fg-muted">Odense</p>
			</div>

			<div class="relative -mt-3 w-[92%] -rotate-2 rounded-box border border-line bg-surface p-4 shadow-lift">
				<div class="flex items-center gap-3">
					<Avatar class="size-9 text-xs" name="Ada Lund" />
					<div class="min-w-0">
						<p class="t-body-sm truncate">
							<span class="font-semibold">Ada Lund</span><span class="text-fg-muted"> on </span><span class="field-label inline">Mangal Express</span>
						</p>
						<p class="t-body-sm text-fg-muted">2 hours ago</p>
					</div>
				</div>
				<span class="mt-2 inline-flex items-center gap-0.5 text-brand-text">
					{Array.from({ length: 4 }, () => <Star size={16} fill="currentColor" />)}
					<StarHalf size={16} fill="currentColor" />
				</span>
				<p class="t-body mt-1">Crisp bread, plenty of meat and a garlic sauce worth the queue. Back on Friday.</p>
				<p class="t-body-sm mt-3 flex items-center gap-1 text-fg-muted">
					<Heart class="text-danger" size={16} fill="currentColor" />12 likes
				</p>
			</div>
		</div>
	</section>

	<ul class="grid gap-x-10 gap-y-8 border-t border-line py-section sm:grid-cols-2">
		{features.map((feature) => {
			const Icon = feature.icon;
			return (
				<li class="flex gap-4">
					<span class="grid size-10 shrink-0 place-items-center rounded-field bg-brand-subtle text-brand-text">
						<Icon size={20} aria-hidden="true" />
					</span>
					<div>
						<h2 class="t-subheading">{feature.title}</h2>
						<p class="t-body mt-1 text-fg-muted">{feature.text}</p>
					</div>
				</li>
			);
		})}
	</ul>

	<section class="flex flex-col items-center gap-5 border-t border-line pt-section text-center sm:flex-row sm:justify-between sm:text-left">
		<h2 class="text-2xl font-semibold tracking-tight text-balance">Where will you eat next?</h2>
		<a class="btn btn-secondary btn-md" href={googleHref}>Sign in with Google</a>
	</section>
</BaseLayout>
