---
import BaseLayout from "@src/layouts/BaseLayout.astro";

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect("/login");
}
---

<BaseLayout
  title="Reviews"
  description="Your reviews"
  includeSidebar={true}
  prefetchUrls={["/", "/explore"]}
  session={session}
  user={session.user}
>
  <h1>Reviews</h1>
  <p class="t-lead mt-2 text-fg-muted">Reviews you've written, drafted or published.</p>
</BaseLayout>
