---
import BaseLayout from "@src/layouts/BaseLayout.astro";

interface Props {
  error: unknown;
}

const { error } = Astro.props

---

<BaseLayout
  title="500: Internal server error"
  description="Something went wrong"
  includeSidebar={false}
  prefetchUrls={["/"]}
>
  <div class="text-center">
    <h1 class="mb-4">❌</h1>
    <h1 class="mb-2">500</h1>
    <div class="t-body text-fg-muted">{error instanceof Error ? error.message : "Unknown error"}</div>
    <a class="btn btn-primary btn-md mt-9" href="/">Home</a>
  </div>
</BaseLayout>
