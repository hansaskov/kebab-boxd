---
import BaseLayout from "@src/layouts/BaseLayout.astro";

interface Props {
  error: unknown;
}

const { error } = Astro.props

// The details stay in the server log. Error messages can describe the database
// or other internals that visitors should not see.
console.error(error)
---

<BaseLayout
  title="500: Internal server error"
  description="Something went wrong"
  includeSidebar={false}
  prefetchUrls={["/"]}
>
  <div class="text-center">
    <h1 class="mb-4">❌</h1>
    <h1 class="mb-2">500</h1>
    <div class="t-body text-fg-muted">Something went wrong on our side. Please try again later.</div>
    <a class="btn btn-primary btn-md mt-9" href="/">Home</a>
  </div>
</BaseLayout>
