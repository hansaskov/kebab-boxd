---
import { actions, isInputError } from "astro:actions";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import FieldInput from "@src/components/FieldInput.astro";
import Pagination from "@src/components/Pagination.astro";
import RestaurantStatusTag from "@src/components/RestaurantStatusTag.astro";
import { can } from "@src/auth/permissions";
import type { QueuedSuggestionStatus } from "@src/db/schema";
import { resultToast } from "@src/format/action-toast";
import { submittedForm } from "@src/actions/submitted-input";
import { formatExactTime, formatRelativeTime } from "@src/format/relative-time";
import { restaurantHref } from "@src/hrefs";
import { pageNavigation, parsePageRequest } from "@src/pagination";
import { suggestionSchema } from "@src/validation/restaurant";

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect("/login");
}

if (!can(session.user, "restaurant:suggest")) {
  return Astro.rewrite("/403");
}

const pageRequest = parsePageRequest(Astro.url);
const [page, queued] = await Promise.all([
  Astro.locals.db.queries.restaurants.listSuggestedBy(session.user.id, pageRequest),
  pageRequest.cursor ? [] : Astro.locals.db.queries.suggestionQueue.listBy(session.user.id),
]);
const navigation = pageNavigation(Astro.url, page);

const result = Astro.getActionResult(actions.restaurants.suggest);
const fieldErrors = result?.error && isInputError(result.error) ? result.error.fields : undefined;
const toast = fieldErrors
  ? undefined
  : resultToast(result, "Suggestion failed", { title: "Thank you for the suggestion", text: "We are looking it up on Google Maps." });
const submitted = submittedForm(Astro.locals, actions.restaurants.suggest);
const { shape } = suggestionSchema;

const queuedLabels: Record<QueuedSuggestionStatus, string> = {
  queued: "Looking it up",
  duplicate: "Already suggested",
  "not-a-place": "Not a restaurant link",
  failed: "Could not look it up",
};
---

<BaseLayout
  title="Suggest a restaurant"
  description="Suggest a kebab restaurant that is missing from Kebab Boxd"
  includeSidebar={true}
  prefetchUrls={["/restaurants"]}
  session={session}
  user={session.user}
  toast={toast}
>
  <h1>Suggest a restaurant</h1>

  <form class="mt-4" method="post" action={actions.restaurants.suggest}>
    <fieldset class="settings-card">
      <FieldInput
        label="Google Maps link"
        name="link"
        value={submitted?.get("link")}
        type="url"
        inputmode="url"
        autocomplete="off"
        placeholder="https://maps.app.goo.gl/…"
        zodField={shape.link}
        errors={fieldErrors?.link}
      />
      <div class="settings-card-footer">
        <button class="btn btn-primary btn-md" type="submit">Send suggestion</button>
      </div>
    </fieldset>
  </form>

  {(queued.length > 0 || page.items.length > 0) && (
    <section class="mt-8" aria-labelledby="suggestions-heading">
      <h2 id="suggestions-heading">Your suggestions</h2>
      <ul class="mt-3 divide-y divide-line rounded-box border border-line bg-surface">
        {queued.map((suggestion) => {
          const duplicate = suggestion.status === "duplicate" ? suggestion.duplicate : null;
          const href = duplicate?.status === "approved" ? restaurantHref(duplicate.id) : undefined;
          const label = duplicate?.status === "approved" ? "Already on Kebab Boxd" : queuedLabels[suggestion.status];
          const Row = href ? "a" : "div";
          return (
            <li>
              <Row class:list={["flex items-center justify-between gap-3 px-4 py-3", { "hover:bg-active": href }]} href={href}>
                <span class="min-w-0">
                  <span class="field-label block truncate">{suggestion.name ?? suggestion.link}</span>
                  <time class="t-body-sm block text-fg-muted" datetime={suggestion.createdAt.toISOString()} title={formatExactTime(suggestion.createdAt)}>
                    {formatRelativeTime(suggestion.createdAt)}
                  </time>
                </span>
                <span class:list={["tag", { "text-danger": suggestion.status !== "queued" }]}>{label}</span>
              </Row>
            </li>
          );
        })}
        {page.items.map((restaurant) => (
          <li>
            <a class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-active" href={restaurantHref(restaurant.id)}>
              <span class="min-w-0">
                <span class="field-label block truncate">{restaurant.name}</span>
                <time class="t-body-sm block text-fg-muted" datetime={restaurant.createdAt.toISOString()} title={formatExactTime(restaurant.createdAt)}>
                  {formatRelativeTime(restaurant.createdAt)}
                </time>
              </span>
              <RestaurantStatusTag status={restaurant.status} />
            </a>
          </li>
        ))}
      </ul>
      {navigation && <Pagination id="suggestion-pages" class="mt-4" aria-label="Suggestion pages" navigation={navigation} />}
    </section>
  )}
</BaseLayout>
