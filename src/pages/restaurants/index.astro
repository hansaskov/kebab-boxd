---
import { Lightbulb } from "@lucide/astro";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import PagedSection from "@src/components/PagedSection.astro";
import RestaurantList from "@src/components/RestaurantList.astro";
import SearchForm from "@src/components/SearchForm.astro";
import TabNav from "@src/components/TabNav.astro";
import { restaurantSorts, type RestaurantSort } from "@src/db/restaurants";
import { firstPageHref, parsePageRequest } from "@src/pagination";
import { parseOption, parseSearch } from "@src/validation/search-params";

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect("/login");
}

const search = parseSearch(Astro.url.searchParams);
const sort = parseOption(Astro.url.searchParams, "sort", restaurantSorts, "top-rated");
const page = await Astro.locals.db.restaurants.list(search, sort, parsePageRequest(Astro.url));

const sortLabels: Record<RestaurantSort, string> = { "top-rated": "Top rated", popular: "Most reviewed", newest: "Newest" };
const sortTabs = restaurantSorts.map((option) => ({
  label: sortLabels[option],
  href: firstPageHref(Astro.url, { sort: option === "top-rated" ? undefined : option }),
  current: option === sort,
}));

const restaurants = page.items.map((restaurant) => ({
  ...restaurant,
  details: [restaurant.location.city, `${restaurant.reviewCount} ${restaurant.reviewCount === 1 ? "review" : "reviews"}`],
}));
---

<BaseLayout
  title="Restaurants"
  description="Browse and search the kebab restaurants on Kebab Boxd"
  prefetchUrls={["/explore", "/restaurants/suggest"]}
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1>Restaurants</h1>
    <a class="btn btn-secondary btn-sm" href="/restaurants/suggest"><Lightbulb size={16} aria-hidden="true" />Suggest a restaurant</a>
  </div>

  <SearchForm class="mt-4" id="restaurant-search" label="Search restaurants" value={search} placeholder="Name or city" />
  <TabNav class="mt-4" aria-label="Sort restaurants" tabs={sortTabs} />

  <PagedSection class="mt-4" aria-label="Restaurants" page={page}>
    <Fragment slot="empty">
      {search
        ? <>No restaurants match “{search}”. <a class="link" href="/restaurants/suggest">Suggest it</a>.</>
        : "There are no restaurants yet."}
    </Fragment>
    <RestaurantList restaurants={restaurants} />
  </PagedSection>
</BaseLayout>
