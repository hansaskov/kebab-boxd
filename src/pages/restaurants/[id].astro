---
import { Bookmark, BookmarkCheck, Heart, SquarePen } from "@lucide/astro";
import { actions } from "astro:actions";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import AverageRating from "@src/components/AverageRating.astro";
import MapView from "@src/components/MapView.astro";
import PagedSection from "@src/components/PagedSection.astro";
import RestaurantStatusTag from "@src/components/RestaurantStatusTag.astro";
import ReviewList from "@src/components/ReviewList.astro";
import SuggestionDecision from "@src/components/SuggestionDecision.astro";
import { canOn, refusal } from "@src/auth/permissions";
import { restaurantMapSize, restaurantMapZoom } from "@src/data/map";
import { exploreHref, newReviewHref, profileHref, refusalPage, searchHref, signInHref } from "@src/hrefs";
import { viewport } from "@src/map/viewport";
import { parsePageRequest } from "@src/pagination";
import { parseId } from "@src/validation/id";

const viewer = Astro.locals.session?.user ?? null;

const id = parseId(Astro.params.id);
const { restaurants, reviews } = Astro.locals.db;
const restaurant = id ? await restaurants.findById(id, viewer?.id ?? null) : undefined;
const refused = refusal(viewer, "restaurant:view", restaurant);
if (refused || !restaurant) {
  return Astro.rewrite(refusalPage[refused ?? "not-found"]);
}

const page = await reviews.listByRestaurant(restaurant.id, viewer?.id ?? null, parsePageRequest(Astro.url));

const { location } = restaurant;
const map = viewport(location, restaurantMapZoom, restaurantMapSize);
const address = [location.addressLine1, location.addressLine2, [location.postalCode, location.city].filter(Boolean).join(" "), location.country]
  .filter(Boolean)
  .join(", ");

const canReview = canOn(viewer, "restaurant:review", restaurant);
const canCollect = canOn(viewer, "restaurant:collect", restaurant);
const canModerate = canOn(viewer, "restaurant:moderate", restaurant);
// A Visitor sees only approved restaurants, which a User may review and save, so they are asked to sign in for it.
const signIn = viewer ? undefined : { toReview: signInHref(newReviewHref(restaurant.id)), toCollect: signInHref(Astro.url) };
---

<BaseLayout
  title={restaurant.name}
  description={`Reviews of ${restaurant.name}${location.city ? ` in ${location.city}` : ""}`}
  prefetchUrls={[...(canReview ? [newReviewHref(restaurant.id)] : signIn ? [signIn.toReview] : []), searchHref("restaurants")]}
>
  <header class="flex flex-wrap items-start gap-4">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="t-subheading">{restaurant.name}</h1>
        {restaurant.status !== "approved" && <RestaurantStatusTag status={restaurant.status} />}
      </div>
      <p class="t-body-sm text-fg-muted">{address}</p>
      <div class="t-body-sm mt-1 flex items-center gap-3 text-fg-muted">
        <AverageRating ratingAvg={restaurant.ratingAvg} />
        <span>{restaurant.reviewCount} {restaurant.reviewCount === 1 ? "review" : "reviews"}</span>
      </div>
    </div>
    {(canReview || signIn) && (
      <a class="btn btn-primary btn-md w-full sm:w-auto" href={signIn?.toReview ?? newReviewHref(restaurant.id)}>
        <SquarePen size={16} aria-hidden="true" />Write a review
      </a>
    )}
  </header>

  {(canCollect || signIn || restaurant.isFavoriteOfViewer || restaurant.isInBucketListOfViewer) && (
    <div class="mt-4 flex gap-2">
      {[
        {
          label: "Favorite",
          collected: restaurant.isFavoriteOfViewer,
          add: actions.restaurants.favorite,
          remove: actions.restaurants.unfavorite,
          icon: <Heart size={16} fill={restaurant.isFavoriteOfViewer ? "currentColor" : "none"} aria-hidden="true" />,
        },
        {
          label: "Bucket list",
          collected: restaurant.isInBucketListOfViewer,
          add: actions.restaurants.addToBucketList,
          remove: actions.restaurants.removeFromBucketList,
          icon: restaurant.isInBucketListOfViewer ? <BookmarkCheck size={16} aria-hidden="true" /> : <Bookmark size={16} aria-hidden="true" />,
        },
      ].map(({ label, collected, add, remove, icon }) =>
        signIn ? (
          <a class="btn btn-secondary btn-md flex-1 sm:flex-none" href={signIn.toCollect}>
            {icon}
            {label}
          </a>
        ) : (
          <form class="flex flex-1 sm:flex-none" method="post" action={collected ? remove : add}>
            <input type="hidden" name="restaurantId" value={restaurant.id} />
            <button class="btn btn-secondary btn-md w-full" type="submit" aria-pressed={collected ? "true" : "false"}>
              {icon}
              {label}
            </button>
          </form>
        ),
      )}
    </div>
  )}

  {canModerate && restaurant.status !== "approved" && (
    <SuggestionDecision class="mt-4" restaurantId={restaurant.id} status={restaurant.status} />
  )}
  {restaurant.status !== "approved" && restaurant.suggester && (
    <p class="t-body-sm mt-4 text-fg-muted">
      Suggested by <a class="link" href={profileHref(restaurant.suggester.username)}>{restaurant.suggester.fullname}</a>
    </p>
  )}

  <MapView
    class="mt-6"
    viewport={map}
    markers={[{ coordinates: location, href: exploreHref({ center: location, zoom: restaurantMapZoom }), label: "Show nearby restaurants" }]}
  />

  <PagedSection class="mt-8 space-y-3" aria-label="Reviews" page={page} empty="No reviews yet.">
    <h2 slot="heading">Reviews</h2>
    <ReviewList reviews={page.items} viewer={viewer} showRestaurant={false} />
  </PagedSection>
</BaseLayout>
