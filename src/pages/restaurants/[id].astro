---
import { SquarePen } from "@lucide/astro";
import { actions } from "astro:actions";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import AverageRating from "@src/components/AverageRating.astro";
import CollectButton from "@src/components/CollectButton.astro";
import MapView from "@src/components/MapView.astro";
import Pagination from "@src/components/Pagination.astro";
import RestaurantStatusTag from "@src/components/RestaurantStatusTag.astro";
import ReviewList from "@src/components/ReviewList.astro";
import SuggestionDecision from "@src/components/SuggestionDecision.astro";
import { canOn } from "@src/auth/permissions";
import { restaurantMapSize, restaurantMapZoom } from "@src/data/map";
import { failureToast } from "@src/format/action-toast";
import { exploreHref, newReviewHref, profileHref } from "@src/hrefs";
import { viewport } from "@src/map/viewport";
import { pageNavigation, parsePageRequest } from "@src/pagination";
import { parseId } from "@src/validation/id";

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect("/login");
}

const id = parseId(Astro.params.id);
const { restaurants, reviews } = Astro.locals.db.queries;
const restaurant = id && (await restaurants.findById(id, session.user.id));

if (!restaurant || !canOn(session.user, "restaurant:view", restaurant)) {
  return Astro.rewrite("/404");
}

const page = await reviews.listByRestaurant(restaurant.id, session.user.id, parsePageRequest(Astro.url));
const navigation = pageNavigation(Astro.url, page);

const { location } = restaurant;
const map = viewport(location, restaurantMapZoom, restaurantMapSize);
const address = [location.addressLine1, location.addressLine2, [location.postalCode, location.city].filter(Boolean).join(" "), location.country]
  .filter(Boolean)
  .join(", ");

const canReview = canOn(session.user, "restaurant:review", restaurant);
const canCollect = canOn(session.user, "restaurant:collect", restaurant);
const canModerate = canOn(session.user, "restaurant:moderate", restaurant);

const toast =
  failureToast(Astro.getActionResult(actions.restaurants.favorite), "Saving failed") ??
  failureToast(Astro.getActionResult(actions.restaurants.addToBucketList), "Saving failed") ??
  failureToast(Astro.getActionResult(actions.reviews.like), "Like failed") ??
  failureToast(Astro.getActionResult(actions.reviews.unlike), "Unlike failed") ??
  failureToast(Astro.getActionResult(actions.admin.approveRestaurant), "Approval failed") ??
  failureToast(Astro.getActionResult(actions.admin.rejectRestaurant), "Rejection failed");
---

<BaseLayout
  title={restaurant.name}
  description={`Reviews of ${restaurant.name}${location.city ? ` in ${location.city}` : ""}`}
  includeSidebar={true}
  prefetchUrls={canReview ? [newReviewHref(restaurant.id), "/restaurants"] : ["/restaurants"]}
  session={session}
  user={session.user}
  toast={toast}
>
  <header class="flex flex-wrap items-start gap-4">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="t-subheading">{restaurant.name}</h1>
        {restaurant.status !== "approved" && <RestaurantStatusTag status={restaurant.status} />}
      </div>
      <p class="t-body-sm text-fg-muted">{address}</p>
      <div class="t-body-sm mt-1 flex items-center gap-3 text-fg-muted">
        <AverageRating ratingAvg={restaurant.ratingAvg} />
        <span>{restaurant.reviewCount} {restaurant.reviewCount === 1 ? "review" : "reviews"}</span>
      </div>
    </div>
    {canReview && (
      <a class="btn btn-primary btn-md w-full sm:w-auto" href={newReviewHref(restaurant.id)}>
        <SquarePen size={16} aria-hidden="true" />Write a review
      </a>
    )}
  </header>

  {(canCollect || restaurant.isFavoriteOfViewer || restaurant.isInBucketListOfViewer) && (
    <div class="mt-4 flex gap-2">
      <CollectButton class="flex-1 sm:flex-none" restaurantId={restaurant.id} collection="favorites" collected={restaurant.isFavoriteOfViewer} />
      <CollectButton class="flex-1 sm:flex-none" restaurantId={restaurant.id} collection="bucketList" collected={restaurant.isInBucketListOfViewer} />
    </div>
  )}

  {canModerate && restaurant.status !== "approved" && (
    <SuggestionDecision class="mt-4" restaurantId={restaurant.id} status={restaurant.status} />
  )}
  {restaurant.status !== "approved" && restaurant.suggester && (
    <p class="t-body-sm mt-4 text-fg-muted">
      Suggested by <a class="link" href={profileHref(restaurant.suggester.username)}>{restaurant.suggester.fullname}</a>
    </p>
  )}

  <MapView
    class="mt-6"
    viewport={map}
    size={restaurantMapSize}
    markers={[{ coordinates: location, href: exploreHref({ center: location, zoom: restaurantMapZoom }), label: "Show nearby restaurants" }]}
  />

  <section class="mt-8" aria-labelledby="reviews-heading">
    <h2 id="reviews-heading">Reviews</h2>
    {page.items.length === 0 ? (
      <p class="t-body mt-2 text-fg-muted">{page.isPastEnd ? "There is nothing on this page." : "No reviews yet."}</p>
    ) : (
      <ReviewList class="mt-3" reviews={page.items} viewer={session.user} showRestaurant={false} />
    )}
    {navigation && <Pagination id="review-pages" class="mt-4" aria-label="Review pages" navigation={navigation} />}
  </section>
</BaseLayout>
