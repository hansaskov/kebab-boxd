---
import BaseLayout from "@src/layouts/BaseLayout.astro";
Astro.response.status = 403
---

<BaseLayout
  title="403: Forbidden"
  description="You do not have permission to open this page"
  includeSidebar={false}
  prefetchUrls={["/"]}
>
  <div class="text-center">
    <h1 class="mb-4">🫤</h1>
    <h1 class="mb-2">403</h1>
    <h3 class="t-subheading">You do not have permission to open this page.</h3>
    <a class="btn btn-primary btn-md mt-9" href="/">Home</a>
  </div>
</BaseLayout>
