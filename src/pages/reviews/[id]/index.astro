---
import { actions } from "astro:actions";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import DeleteReviewButton from "@src/components/DeleteReviewButton.astro";
import DeleteReviewDialog from "@src/components/DeleteReviewDialog.astro";
import ReviewCard from "@src/components/ReviewCard.astro";
import { canOn, refusal } from "@src/auth/permissions";
import { successToast } from "@src/format/action-toast";
import { profileHref, refusalPage, restaurantHref } from "@src/hrefs";
import { parseId } from "@src/validation/id";

const viewer = Astro.locals.session?.user ?? null;

const id = parseId(Astro.params.id);
const review = id ? await Astro.locals.db.reviews.findById(id, viewer?.id ?? null) : undefined;
const refused = refusal(viewer, "review:view", review);
if (refused || !review) {
  return Astro.rewrite(refusalPage[refused ?? "not-found"]);
}

const canEdit = canOn(viewer, "review:edit", review);
const canDelete = canOn(viewer, "review:delete", review);

const toast =
  successToast(Astro.locals, actions.reviews.create, { title: "Review published", text: `Your review of ${review.restaurant.name} is up.` }) ??
  successToast(Astro.locals, actions.reviews.update, { title: "Review saved", text: "Your changes are saved." });
---

<BaseLayout
  title={`${review.author.fullname} on ${review.restaurant.name}`}
  description={review.description ?? `A review of ${review.restaurant.name}`}
  prefetchUrls={[restaurantHref(review.restaurant.id), profileHref(review.author.username)]}
  toast={toast}
>
  <ReviewCard class="rounded-box border border-line bg-surface" review={review} viewer={viewer} />

  {canDelete && !canEdit && (
    <>
      <DeleteReviewButton class="mt-6" reviewId={review.id} />
      <DeleteReviewDialog reviewId={review.id} />
    </>
  )}
</BaseLayout>
