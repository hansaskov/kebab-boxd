---
import { X } from "@lucide/astro";
import { actions } from "astro:actions";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import DeleteReviewButton from "@src/components/DeleteReviewButton.astro";
import DeleteReviewDialog from "@src/components/DeleteReviewDialog.astro";
import FieldFile from "@src/components/FieldFile.astro";
import FieldRating from "@src/components/FieldRating.astro";
import FieldTextArea from "@src/components/FieldTextArea.astro";
import { refusal } from "@src/auth/permissions";
import { submittedForm } from "@src/actions/outcome";
import { refusalPage, restaurantHref, reviewHref, signInHref } from "@src/hrefs";
import { parseId } from "@src/validation/id";
import { maxPicturesPerReview, updateReviewSchema } from "@src/validation/review";

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect(signInHref(Astro.url, "edit-review"));
}

const id = parseId(Astro.params.id);
const review = id ? await Astro.locals.db.reviews.findById(id, session.user.id) : undefined;
const refused = refusal(session.user, "review:edit", review);
if (refused || !review) {
  return Astro.rewrite(refusalPage[refused ?? "not-found"]);
}

const submitted = submittedForm(Astro.locals, actions.reviews.update);
const { shape } = updateReviewSchema;
---

<BaseLayout
  title={`Edit review of ${review.restaurant.name}`}
  description={`Change your review of ${review.restaurant.name}`}
  prefetchUrls={[reviewHref(review.id), restaurantHref(review.restaurant.id)]}
  toast={submitted?.hasFieldErrors ? null : undefined}
>
  <h1>Edit review of <a class="link-hover" href={restaurantHref(review.restaurant.id)}>{review.restaurant.name}</a></h1>

  <form class="mt-4" method="post" action={actions.reviews.update} enctype="multipart/form-data">
    <input type="hidden" name="reviewId" value={review.id} />
    <fieldset class="settings-card">
      <FieldRating layout="stack" label="Rating" name="rating" selected={review.rating} submitted={submitted} zodField={shape.rating} />
      <FieldTextArea
        layout="stack"
        class="min-h-56"
        label="Review"
        name="description"
        placeholder="What was good, and what was not?"
        value={review.description}
        submitted={submitted}
        zodField={shape.description}
      />
      {review.pictures.length > 0 && (
        <div class="field-stack space-y-2">
          <p id="current-pictures-label" class="field-label">Pictures</p>
          <ul class="grid grid-cols-2 gap-2 sm:grid-cols-4" aria-labelledby="current-pictures-label">
            {review.pictures.map((picture, i) => (
              <li class="relative">
                <img class="aspect-square w-full rounded-field bg-subtle object-cover" src={picture.url} alt={`Picture ${i + 1}`} />
                <!-- Sends the form after the review form, so a removal sends no new pictures with it. -->
                <button
                  class="picture-remove"
                  type="submit"
                  form="remove-picture"
                  name="pictureId"
                  value={picture.id}
                  aria-label={`Remove picture ${i + 1}`}
                >
                  <X size={16} aria-hidden="true" />
                </button>
              </li>
            ))}
          </ul>
        </div>
      )}
      <FieldFile
        label="Add pictures"
        prompt="Choose pictures to add"
        name="pictures"
        description={`A review can have up to ${maxPicturesPerReview}.`}
        multiple
        submitted={submitted}
      />
      <div class="settings-card-footer justify-between gap-2">
        <DeleteReviewButton reviewId={review.id} />
        <button class="btn btn-primary btn-md" type="submit">Save review</button>
      </div>
    </fieldset>
  </form>
  {review.pictures.length > 0 && (
    <form id="remove-picture" method="post" action={actions.reviews.removePicture}>
      <input type="hidden" name="reviewId" value={review.id} />
    </form>
  )}
  <DeleteReviewDialog reviewId={review.id} />
</BaseLayout>
