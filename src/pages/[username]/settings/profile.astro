---
import { actions } from "astro:actions";
import SettingsLayout from "@src/layouts/SettingsLayout.astro";
import Avatar from "@src/components/Avatar.astro";
import FieldFile from "@src/components/FieldFile.astro";
import FieldInput from "@src/components/FieldInput.astro";
import FieldSelect from "@src/components/FieldSelect.astro";
import FieldTextArea from "@src/components/FieldTextArea.astro";
import { updateAccountSchema } from "@src/actions/settings";
import { submittedForm } from "@src/actions/outcome";
import { successToast } from "@src/format/action-toast";
import { profileHref } from "@src/hrefs";
import { openSettings, otherSectionHrefs } from "@src/settings";

const settings = await openSettings(Astro, "profile");
if (settings instanceof Response) {
  return settings;
}
const { user } = settings;

const detailsForm = submittedForm(Astro.locals, actions.updateSettings);
const pictureForm = submittedForm(Astro.locals, actions.updateProfilePicture);
// A taken username is a conflict with another account, but the user fixes it in the field.
const usernameErrors = detailsForm?.code === "CONFLICT" ? [detailsForm.message] : undefined;
const shownInline = [detailsForm, pictureForm].some((form) => form?.hasFieldErrors) || usernameErrors !== undefined;

const toast = shownInline
  ? null
  : (successToast(Astro.locals, actions.updateSettings, { title: "Profile saved", text: "Your profile shows the changes." }) ??
    successToast(Astro.locals, actions.updateProfilePicture, { title: "Picture saved", text: "Your profile shows the new picture." }) ??
    successToast(Astro.locals, actions.removeProfilePicture, { title: "Picture removed", text: "Your profile shows your initials." }));
---

<SettingsLayout
  settings={settings}
  section="profile"
  title="Profile settings"
  description={`The profile of ${user.fullname}`}
  prefetchUrls={[profileHref(user.username), ...otherSectionHrefs(settings, "profile")]}
  toast={toast}
>
  <h1>Profile</h1>

  <section class="mt-6" aria-labelledby="details-heading">
    <h2 id="details-heading">Details</h2>
    <form class="mt-3" method="post" action={actions.updateSettings}>
      <input type="hidden" name="currentUsername" value={user.username} />
      <fieldset class="settings-card">
        <FieldInput
          label="Full name"
          name="fullname"
          description="Shown on your profile. Use your real name."
          type="text"
          value={user.fullname}
          submitted={detailsForm}
          zodField={updateAccountSchema.shape.fullname}
        />
        <FieldInput
          label="Username"
          name="username"
          description="Others use it to find you. It must be unique."
          type="text"
          value={user.username}
          submitted={detailsForm}
          zodField={updateAccountSchema.shape.username}
          errors={usernameErrors}
        />
        <FieldSelect
          label="Pronouns"
          name="pronoun"
          selected={user.pronoun}
          submitted={detailsForm}
          description="How others refer to you."
          zodField={updateAccountSchema.shape.pronoun}
        />
        <FieldTextArea
          label="Bio"
          name="bio"
          description="A short text about you on your profile."
          value={user.bio}
          submitted={detailsForm}
          zodField={updateAccountSchema.shape.bio}
        />
        <div class="settings-card-footer">
          <button class="btn btn-primary btn-md" type="submit">Save profile</button>
        </div>
      </fieldset>
    </form>
  </section>

  <section class="mt-8" aria-labelledby="picture-heading">
    <h2 id="picture-heading">Picture</h2>
    <form class="mt-3" method="post" action={actions.updateProfilePicture} enctype="multipart/form-data">
      <input type="hidden" name="currentUsername" value={user.username} />
      <fieldset class="settings-card">
        <div class="settings-row">
          <Avatar class="size-20 text-2xl" name={user.fullname} picture={user.profilePicture} />
        </div>
        <FieldFile label="New picture" name="picture" required submitted={pictureForm} />
        <div class="settings-card-footer gap-2">
          {user.profilePicture && (
            <button class="btn btn-secondary btn-md" type="submit" formaction={actions.removeProfilePicture} formnovalidate>
              Remove picture
            </button>
          )}
          <button class="btn btn-primary btn-md" type="submit">Save picture</button>
        </div>
      </fieldset>
    </form>
  </section>
</SettingsLayout>
