---
import { settingsSidebarMenuSections } from "@src/data/sidebar-menu-sections";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import { can } from "@src/auth/permissions";
import PagedSection from "@src/components/PagedSection.astro";
import RelativeTime from "@src/components/RelativeTime.astro";
import Stat from "@src/components/Stat.astro";
import { parsePageRequest } from "@src/pagination";
import { deviceName } from "@src/format/device-name";
import { sessionHistoryHref, settingsHref } from "@src/hrefs";

const { username, sessionId } = Astro.params;

if (!username || !sessionId) {
    return Astro.rewrite("/404");
}

const session = Astro.locals.session;

if (!session) {
    return Astro.redirect("/login");
}

const owner = await Astro.locals.db.queries.users.findByUsername(username);

if (!owner) {
    return Astro.rewrite("/404");
}

if (owner.username !== username) {
    return Astro.redirect(`${sessionHistoryHref(owner.username, sessionId)}${Astro.url.search}`, 301);
}

if (!can(session.user, "user:manage-sessions", owner)) {
    return Astro.rewrite("/403");
}

const selectedSession = await Astro.locals.db.queries.sessions.findActive(
    sessionId,
    owner.id,
);

if (!selectedSession) {
    return Astro.rewrite("/404");
}

const page = await Astro.locals.db.queries.history.listBySession(
    sessionId,
    parsePageRequest(Astro.url),
);

const lastRequestAt = selectedSession.history.at(0)?.requestedAt;
const name = deviceName(selectedSession, session.id);
const ownerSettingsHref = settingsHref(owner.username);
---

<BaseLayout
    title={name}
    description={`History for ${name.toLowerCase()} of ${owner.fullname}`}
    prefetchUrls={[ownerSettingsHref, "/explore", "/reviews", "/"]}
    sidebarMenuSections={settingsSidebarMenuSections(owner.username)}
>
    <h1>{name}</h1>

    <dl class="t-body-sm mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
        <Stat label="Signed in"><RelativeTime date={selectedSession.createdAt} /></Stat>
        <Stat label="Last used">{lastRequestAt ? <RelativeTime date={lastRequestAt} /> : "Never"}</Stat>
        <Stat class="col-span-2 sm:col-span-1" label="Requests">{selectedSession.requestCount}</Stat>
    </dl>

    <PagedSection class="mt-8 space-y-4" aria-label="History" page={page} empty="This session has not made any requests yet.">
        <h2 slot="heading">History</h2>
        <ol class="divide-y divide-line rounded-box border border-line bg-surface">
            {page.items.map((entry) => (
                <li class="flex items-center gap-3 px-4 py-3">
                    <span
                        class="tag min-w-[8ch] shrink-0 justify-center"
                        title={entry.prefetched ? "Prefetched: the browser loaded this page early, in case it was opened next" : undefined}
                    >
                        {entry.prefetched ? "PRE" : entry.method}
                    </span>
                    <span class:list={["t-body-sm shrink-0 text-fg-muted", { "text-danger": entry.status >= 400 }]}>{entry.status}</span>
                    <span class="flex min-w-0 flex-1 items-center gap-2">
                        <span class="t-body min-w-0 truncate">{entry.path}</span>
                        {entry.action && <span class="t-body-sm min-w-0 truncate text-fg-muted">{entry.action}</span>}
                    </span>
                    <RelativeTime class="t-body-sm shrink-0 text-right text-fg-muted" date={entry.requestedAt} narrow />
                </li>
            ))}
        </ol>
    </PagedSection>
</BaseLayout>
