---
import { actions } from "astro:actions";
import SettingsLayout from "@src/layouts/SettingsLayout.astro";
import { successToast } from "@src/format/action-toast";
import { openSettings, otherSectionHrefs } from "@src/settings";

const settings = await openSettings(Astro, "notifications");
if (settings instanceof Response) {
  return settings;
}
const { user } = settings;

const kinds = [
  { label: "New followers", name: "followNotifications", checked: user.followNotifications },
  { label: "Likes on reviews", name: "likeNotifications", checked: user.likeNotifications },
  { label: "Decisions on suggestions", name: "suggestionNotifications", checked: user.suggestionNotifications },
];
---

<SettingsLayout
  settings={settings}
  section="notifications"
  title="Notification settings"
  description={`The notifications ${user.fullname} gets`}
  prefetchUrls={["/notifications", ...otherSectionHrefs(settings, "notifications")]}
  toast={successToast(Astro.locals, actions.updateNotifications, { title: "Notifications saved", text: "You get the notifications you chose." })}
>
  <h1>Notifications</h1>

  <form class="mt-6" method="post" action={actions.updateNotifications}>
    <input type="hidden" name="currentUsername" value={user.username} />
    <fieldset class="settings-card">
      {kinds.map(({ label, name, checked }) => (
        <label class="flex cursor-pointer items-center justify-between gap-6 py-5">
          <span class="field-label">{label}</span>
          <input type="checkbox" class="checkbox" name={name} checked={checked} />
        </label>
      ))}
      <div class="settings-card-footer">
        <button class="btn btn-primary btn-md" type="submit">Save notifications</button>
      </div>
    </fieldset>
  </form>
</SettingsLayout>
