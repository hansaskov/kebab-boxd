---
import { UserRoundCog, Shield, Bell} from "@lucide/astro";
import { getSessionAndUserFromCookie } from "@src/auth/session";
import { pronouns } from "@src/data/pronouns";
import { defaultSidebarMenuSections } from "@src/data/sidebar-menu-sections";
import BaseLayout from "@src/layouts/BaseLayout.astro";

const { username: encodedUsername } = Astro.params

if ( !encodedUsername ) {
  return Astro.rewrite("/404")
}
const username = decodeURIComponent(encodedUsername);

const session = await getSessionAndUserFromCookie(Astro.cookies, Astro.locals.db);

// User is not authenticated
if (!session) {
  return Astro.redirect("/login");
}

const user = await Astro.locals.db.query.users.findFirst({
  where: {
    username: {
      eq: username
    }
  }
})

// User does not exsist
if (!user) {
  return Astro.rewrite("/404")
}

// User not authorized

if (session.user.isAdmin === false && session.user.id !== user.id ) {
  return Astro.rewrite("/401")
}

const settingsSidebarMenuSection = defaultSidebarMenuSections.concat([
  {
    title: "Settings",
    items: [
      {
        name: "Account",
        href: `/${encodeURIComponent(username)}/settings#account`,
        icon: UserRoundCog
      },
      {
        name: "Security",
        href: `/${encodeURIComponent(username)}/settings#security`,
        icon: Shield
      },
      {
        name: "Notifications",
        href: `/${encodeURIComponent(username)}/settings#notifications`,
        icon: Bell
      },
    ]
  }
])

---

<BaseLayout
  class=""
  title="Settings"
  description={`Settings page for ${user.fullname}`}
  includeSidebar={true}
  prefetchUrls={["/explore", "/reviews"]}
  session={session}
  user={session.user}
  sidebarMenuSections={settingsSidebarMenuSection}
>
  <h1 class="text-4xl font-bold">Settings</h1>
  <section id="account" class="mt-8">
    <h2 class="text-2xl font-bold">Account</h2>
    <form class="space-y-4">
      <fieldset class="fieldset">
        <legend class="fieldset-legend">User Settings</legend>
        
        <label class="fieldset-label" for="fullname">Full Name</label>
        <input 
          id="fullname"
          type="text" 
          class="input validator w-full" 
          required 
          value={user.fullname} 
          minlength="3"
          maxlength="30"
          />
        <p class="fieldset-label">The name that is shown on your profile page. Use your real name.</p>
        <p class="hidden validator-hint">Must be 3 to 30 characters</p>
        
        <label class="fieldset-label" for="username">Username</label>
        <input 
          id="username"
          type="text" 
          class="input validator w-full" 
          required 
          value={user.username} 
          minlength="3"
          maxlength="30" />
        <p class="label">Other users use this name to find you. It must be unique.</p>
        <p class="hidden validator-hint">Must be 3 to 30 characters</p>
        

        <label class="fieldset-label" for="pronouns">Pronouns</label>
        <select id="pronouns" class="select appearance-none w-full">
          <option disabled selected>Select your pronoun</option>
          {pronouns.map(pronoun => (
            <option selected={user.pronoun === pronoun}>{pronoun}</option>
          ))}
        </select>
        <p class="label">The words that other users use to refer to you. Example: They / their.</p>

        <label class="fieldset-label" for="bio">Bio</label>
        <textarea id="bio" class="textarea w-full" value={user.bio} ></textarea>
        <p class="label">Write a short text about yourself. It is shown on your profile page.</p>
    </fieldset>

    <div class="flex justify-end">
      <button class="btn btn-neutral">Submit</button>
    </div>
    </form>
  </section>
  <section id="security" class="mt-8">
    <h2 class="text-2xl font-bold">Security</h2>
    <p class="mt-2 text-base-content/60">Placeholder for security settings.</p>
  </section>
  <section id="notifications" class="mt-8">
    <h2 class="text-2xl font-bold">Notifications</h2>
    <p class="mt-2 text-base-content/60">Placeholder for notification settings.</p>
  </section>
</BaseLayout>
