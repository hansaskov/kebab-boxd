---
import { UserRoundCog, Shield, Bell } from "@lucide/astro";
import { actions, isInputError } from "astro:actions";
import { updateSettingsInput } from "@src/actions";
import { defaultSidebarMenuSections } from "@src/data/sidebar-menu-sections";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import FieldInput from "@src/components/FieldInput.astro";
import FieldSelect from "@src/components/FieldSelect.astro";
import FieldTextArea from "@src/components/FieldTextArea.astro";

const { username: encodedUsername } = Astro.params;

if (!encodedUsername) {
  return Astro.rewrite("/404");
}

const userSettingsUpdateSchema = updateSettingsInput;

const username = decodeURIComponent(encodedUsername);
const actionResult = Astro.getActionResult(actions.updateSettings);

const isInputActionError = isInputError(actionResult?.error);
const fieldErrors = isInputActionError
  ? (
      actionResult.error as unknown as {
        fields: Record<string, string[] | undefined>;
      }
    ).fields
  : {};
  
const usernameErrors =
  actionResult?.error?.code === "CONFLICT"
    ? [actionResult.error.message]
    : fieldErrors.username;

const toast =
  actionResult && !actionResult.error
    ? ({
        kind: "title",
        title: "Settings updated",
        text: "Your profile changes have been saved.",
      } as const)
    : undefined;

const session = Astro.locals.session;

// User is not authenticated
if (!session) {
  return Astro.redirect("/login");
}

const user = await Astro.locals.db.query.users.findFirst({
  where: {
    username: {
      eq: username,
    },
  },
});

// User does not exsist
if (!user) {
  return Astro.rewrite("/404");
}

// User not authorized
if (session.user.isAdmin === false && session.user.id !== user.id) {
  return Astro.rewrite("/401");
}

const settingsSidebarMenuSection = defaultSidebarMenuSections.concat([
  {
    title: "Settings",
    items: [
      {
        name: "Account",
        href: `/${encodeURIComponent(username)}/settings#account`,
        icon: UserRoundCog,
      },
      {
        name: "Security",
        href: `/${encodeURIComponent(username)}/settings#security`,
        icon: Shield,
      },
      {
        name: "Notifications",
        href: `/${encodeURIComponent(username)}/settings#notifications`,
        icon: Bell,
      },
    ],
  },
]);
---w

<BaseLayout
  class=""
  title="Settings"
  description={`Settings page for ${user.fullname}`}
  includeSidebar={true}
  prefetchUrls={["/explore", "/reviews", "/"]}
  session={session}
  user={session.user}
  sidebarMenuSections={settingsSidebarMenuSection}
  toast={toast}
>
  <h1 class="text-4xl font-bold">Settings</h1>
  <section id="account" class="mt-8">
    <h2 class="text-2xl font-bold">Account</h2>
    <form class="mt-6 space-y-6" method="post" action={actions.updateSettings}>
      <input type="hidden" name="currentUsername" value={user.username} />
      <fieldset class="space-y-6">
        <legend class="text-lg font-semibold">User Settings</legend>

        <FieldInput
          title="Full Name"
          name="fullname"
          description="The name that is shown on your profile page. Use your real name."
          type="text"
          value={user.fullname}
          zodField={userSettingsUpdateSchema.shape.fullname}
        />

        <FieldInput
          title="Username"
          name="username"
          description="Other users use this name to find you. It must be unique"
          type="text"
          value={user.username}
          zodField={userSettingsUpdateSchema.shape.username}
          errors={usernameErrors}
        />

        <FieldSelect
          title="Pronouns"
          name="pronoun"
          selected={user.pronoun}
          description="The words that other users use to refer to you. Example: They / their."
          zodField={userSettingsUpdateSchema.shape.pronoun}
          errors={fieldErrors.pronoun}
        />

        <FieldTextArea
          title="Bio"
          name="bio"
          description="Write a short text about yourself. It is shown on your profile page."
          value={user.bio}
          zodField={userSettingsUpdateSchema.shape.bio}
        />
      </fieldset>

      <div class="flex justify-end">
        <button class="btn btn-neutral" type="submit">Save settings</button>
      </div>
    </form>
  </section>
  <section id="security" class="mt-8">
    <h2 class="text-2xl font-bold">Security</h2>
    <p class="mt-2 text-base-content/60">Placeholder for security settings.</p>
  </section>
  <section id="notifications" class="mt-8">
    <h2 class="text-2xl font-bold">Notifications</h2>
    <p class="mt-2 text-base-content/60">
      Placeholder for notification settings.
    </p>
  </section>
</BaseLayout>
