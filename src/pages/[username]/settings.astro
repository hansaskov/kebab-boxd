---
import { actions, isInputError } from "astro:actions";
import { settingsSidebarMenuSections } from "@src/data/sidebar-menu-sections";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import DialogDrawer from "@src/components/DialogDrawer.astro";
import Avatar from "@src/components/Avatar.astro";
import FieldCheckbox from "@src/components/FieldCheckbox.astro";
import FieldFile from "@src/components/FieldFile.astro";
import FieldInput from "@src/components/FieldInput.astro";
import FieldSelect from "@src/components/FieldSelect.astro";
import FieldTextArea from "@src/components/FieldTextArea.astro";
import type { Toast } from "@src/components/Toast.astro";
import {
    deleteAccountSchema,
    updateAccountSchema,
} from "@src/actions/settings";
import { coordinatesTextSchema, formatCoordinates } from "@src/validation/coordinates";
import { resultToast } from "@src/format/action-toast";
import { submittedForm } from "@src/actions/submitted-input";
import { can } from "@src/auth/permissions";
import { deviceName } from "@src/format/device-name";
import { personalDataExportHref, sessionHistoryHref, settingsHref } from "@src/hrefs";
import { formatExactTime, formatRelativeTime } from "@src/format/relative-time";

const { username } = Astro.params;

if (!username) {
    return Astro.rewrite("/404");
}

const session = Astro.locals.session;

if (!session) {
    return Astro.redirect("/login");
}

const user = await Astro.locals.db.queries.users.findByUsernameWithPicture(username);

if (!user) {
    return Astro.rewrite("/404");
}

if (user.username !== username) {
    return Astro.redirect(`${settingsHref(user.username)}${Astro.url.search}`, 301);
}

if (!can(session.user, "user:edit-settings", user)) {
    return Astro.rewrite("/403");
}

const canManageSessions = can(session.user, "user:manage-sessions", user);
const canExportData = can(session.user, "user:export-data", user);
const canDeleteAccount = can(session.user, "user:delete-account", user);

const actionResult = Astro.getActionResult(actions.updateSettings);
const accountForm = submittedForm(Astro.locals, actions.updateSettings);
const locationForm = submittedForm(Astro.locals, actions.updateLocation);
const deleteForm = submittedForm(Astro.locals, actions.deleteAccount);
const signOutResult = Astro.getActionResult(actions.signOutEverywhere);
const deleteResult = Astro.getActionResult(actions.deleteAccount);
const pictureResult = Astro.getActionResult(actions.updateProfilePicture);
const locationResult = Astro.getActionResult(actions.updateLocation);
const isOwnAccount = session.user.id === user.id;

const activeSessions = canManageSessions
    ? await Astro.locals.db.queries.sessions.listActive(user.id)
    : [];

let usernameErrors: string[] | undefined;
let confirmationErrors: string[] | undefined;
const pictureErrors = pictureResult?.error && isInputError(pictureResult.error) ? pictureResult.error.fields.picture : undefined;
const locationErrors = locationResult?.error && isInputError(locationResult.error) ? locationResult.error.fields.location : undefined;
let toast: Toast | undefined =
    (pictureErrors ? undefined : resultToast(pictureResult, "Upload failed", {
        title: "Picture saved",
        text: "Your profile shows the new picture.",
    })) ??
    resultToast(Astro.getActionResult(actions.removeProfilePicture), "Removal failed", {
        title: "Picture removed",
        text: "Your profile shows your initials.",
    }) ??
    (locationErrors ? undefined : resultToast(locationResult, "Saving failed", {
        title: "Location saved",
        text: "The map starts at your location.",
    })) ??
    resultToast(Astro.getActionResult(actions.updateNotifications), "Saving failed", {
        title: "Notifications saved",
        text: "You get the notifications you chose.",
    });

if (actionResult) {
    if (actionResult.error) {
        if (actionResult.error.code == "CONFLICT") {
            usernameErrors = [actionResult.error.message];
        } else if (
            isInputError(actionResult.error) &&
            actionResult.error.fields.username
        ) {
            usernameErrors = actionResult.error.fields.username;
        } else {
            toast = {
                kind: "title",
                variant: "error",
                title: "Submission failed",
                text: actionResult.error.message,
            };
        }
    }

    if (actionResult.data) {
        toast = {
            kind: "title",
            title: "Settings updated",
            text: "Your profile changes have been saved.",
        };
    }
}

if (signOutResult) {
    toast = signOutResult.error
        ? {
              kind: "title",
              variant: "error",
              title: "Sign-out failed",
              text: signOutResult.error.message,
          }
        : {
              kind: "title",
              title: "Signed out everywhere",
              text: `${user.fullname} must sign in again on every device.`,
          };
}

if (deleteResult?.error) {
    if (
        isInputError(deleteResult.error) &&
        deleteResult.error.fields.confirmation
    ) {
        confirmationErrors = deleteResult.error.fields.confirmation;
    } else {
        toast = {
            kind: "title",
            variant: "error",
            title: "Deletion failed",
            text: deleteResult.error.message,
        };
    }
}

const exportHref = personalDataExportHref(user.username);
const settingsSidebarMenuSection = settingsSidebarMenuSections(username);
---

<BaseLayout
    class=""
    title="Settings"
    description={`Settings page for ${user.fullname}`}
    includeSidebar={true}
    prefetchUrls={["/explore", "/reviews", "/"]}
    session={session}
    user={session.user}
    sidebarMenuSections={settingsSidebarMenuSection}
    toast={toast}
>
    <h1>Settings</h1>

    <section id="account" class="mt-8">
        <h2>Account</h2>
        <form class="mt-3" method="post" action={actions.updateSettings}>
            <input type="hidden" name="currentUsername" value={user.username} />
            <fieldset class="settings-card">
                <FieldInput
                    label="Full name"
                    name="fullname"
                    description="Shown on your profile. Use your real name."
                    type="text"
                    value={accountForm?.get("fullname") ?? user.fullname}
                    zodField={updateAccountSchema.shape.fullname}
                />

                <FieldInput
                    label="Username"
                    name="username"
                    description="Others use it to find you. It must be unique."
                    type="text"
                    value={accountForm?.get("username") ?? user.username}
                    zodField={updateAccountSchema.shape.username}
                    errors={usernameErrors}
                />

                <FieldSelect
                    label="Pronouns"
                    name="pronoun"
                    selected={accountForm ? accountForm.get("pronoun") || null : user.pronoun}
                    description="How others refer to you."
                    zodField={updateAccountSchema.shape.pronoun}
                />

                <FieldTextArea
                    label="Bio"
                    name="bio"
                    description="A short text about you on your profile."
                    value={accountForm?.get("bio") ?? user.bio}
                    zodField={updateAccountSchema.shape.bio}
                />
                <div class="settings-card-footer">
                    <button class="btn btn-primary btn-md" type="submit">
                        Save settings
                    </button>
                </div>
            </fieldset>
        </form>
    </section>

    <section id="picture" class="mt-8">
        <h2>Picture</h2>
        <form class="mt-3" method="post" action={actions.updateProfilePicture} enctype="multipart/form-data">
            <input type="hidden" name="currentUsername" value={user.username} />
            <fieldset class="settings-card">
                <div class="settings-row">
                    <Avatar class="size-20 text-2xl" name={user.fullname} picture={user.profilePicture} />
                </div>
                <FieldFile label="New picture" name="picture" required errors={pictureErrors} />
                <div class="settings-card-footer gap-2">
                    {user.profilePicture && (
                        <button class="btn btn-secondary btn-md" type="submit" formaction={actions.removeProfilePicture} formnovalidate>
                            Remove picture
                        </button>
                    )}
                    <button class="btn btn-primary btn-md" type="submit">Save picture</button>
                </div>
            </fieldset>
        </form>
    </section>

    <section id="location" class="mt-8">
        <h2>Location</h2>
        <form class="mt-3" method="post" action={actions.updateLocation}>
            <input type="hidden" name="currentUsername" value={user.username} />
            <fieldset class="settings-card">
                <FieldInput
                    label="Coordinates"
                    name="location"
                    description="The map starts here. Only you can see it."
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    placeholder="55.3959, 10.3883"
                    value={locationForm?.get("location") ??
                        (user.latitude !== null && user.longitude !== null ? formatCoordinates({ latitude: user.latitude, longitude: user.longitude }) : "")}
                    zodField={coordinatesTextSchema.nullable()}
                    errors={locationErrors}
                />
                <div class="settings-card-footer">
                    <button class="btn btn-primary btn-md" type="submit">Save location</button>
                </div>
            </fieldset>
        </form>
    </section>

    <section id="security" class="mt-8">
        <h2>Security</h2>
        <div class="settings-card mt-3">
            <p class="settings-row t-body-sm text-fg-muted">
                Placeholder for security settings.
            </p>
        </div>
    </section>

    {canManageSessions && (
        <section id="devices" class="mt-8">
            <h2>Devices</h2>
            <div class="settings-card mt-3">
                {activeSessions.length === 0 ? (
                    <p class="settings-row t-body-sm text-fg-muted">
                        There are no signed-in devices.
                    </p>
                ) : (
                    <ul>
                        {activeSessions.map(({ history: [lastRequest], ...activeSession }) => (
                            <li>
                                <a
                                    class="settings-link"
                                    href={sessionHistoryHref(user.username, activeSession.id)}
                                >
                                    <span class="field-label">
                                        {deviceName(activeSession, session.id)}
                                    </span>
                                    <span class="t-body-sm text-fg-muted">
                                        Last used{" "}
                                        {lastRequest ? (
                                            <time
                                                datetime={lastRequest.requestedAt.toISOString()}
                                                title={formatExactTime(
                                                    lastRequest.requestedAt,
                                                )}
                                            >
                                                {formatRelativeTime(
                                                    lastRequest.requestedAt,
                                                )}
                                            </time>
                                        ) : (
                                            "never"
                                        )}
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ul>
                )}
            </div>
        </section>
    )}

    <section id="notifications" class="mt-8">
        <h2>Notifications</h2>
        <form class="mt-3" method="post" action={actions.updateNotifications}>
            <input type="hidden" name="currentUsername" value={user.username} />
            <fieldset class="settings-card">
                <FieldCheckbox label="New followers" name="followNotifications" checked={user.followNotifications} />
                <FieldCheckbox label="Likes on reviews" name="likeNotifications" checked={user.likeNotifications} />
                <FieldCheckbox label="Decisions on suggestions" name="suggestionNotifications" checked={user.suggestionNotifications} />
                <div class="settings-card-footer">
                    <button class="btn btn-primary btn-md" type="submit">Save notifications</button>
                </div>
            </fieldset>
        </form>
    </section>

    {canExportData && (
        <section id="your-data" class="mt-8">
            <h2>Your data</h2>
            <div class="settings-card mt-3">
                <div class="settings-row">
                    <div class="settings-row-text">
                        <p class="field-label">Download data</p>
                        <p class="t-body-sm text-fg-muted">
                            Everything we store about you.
                        </p>
                    </div>
                    <a
                        class="btn btn-secondary btn-md settings-row-action"
                        href={exportHref}
                        download
                    >
                        Download
                    </a>
                </div>
            </div>
        </section>
    )}

    {canManageSessions && (
        <section id="danger-zone" class="mt-8">
            <h2 class="text-danger">Danger zone</h2>
            <div class="settings-card settings-card-danger mt-3">
                <form
                    class="settings-row"
                    method="post"
                    action={actions.signOutEverywhere}
                >
                    <input
                        type="hidden"
                        name="currentUsername"
                        value={user.username}
                    />
                    <div class="settings-row-text">
                        <p class="field-label">Sign out everywhere</p>
                        <p class="t-body-sm text-fg-muted">
                            {isOwnAccount
                                ? "Sign out on all devices, including this one."
                                : `Sign ${user.fullname} out on all devices.`}
                        </p>
                    </div>
                    <button
                        class="btn btn-danger btn-md settings-row-action"
                        type="submit"
                    >
                        Sign out everywhere
                    </button>
                </form>
                {canDeleteAccount ? (
                    <div class="settings-row">
                        <div class="settings-row-text">
                            <p class="field-label">Close account</p>
                            <p class="t-body-sm text-fg-muted">
                                Permanently deletes your account.
                            </p>
                        </div>
                        <button
                            class="btn btn-danger btn-md settings-row-action"
                            type="button"
                            commandfor="delete-account"
                            command="show-modal"
                        >
                            Delete account
                        </button>
                    </div>
                ) : (
                    isOwnAccount && (
                        <p class="settings-row t-body-sm text-fg-muted">
                            Ask another admin to remove your Admin role before
                            you delete your account.
                        </p>
                    )
                )}
            </div>
            {canDeleteAccount && (
                <DialogDrawer
                    id="delete-account"
                    title="Are you sure?"
                    description="Deleting your account cannot be undone."
                    open={confirmationErrors !== undefined}
                >
                    <form
                        class="space-y-5"
                        method="post"
                        action={actions.deleteAccount}
                    >
                        <input
                            type="hidden"
                            name="currentUsername"
                            value={user.username}
                        />
                        <FieldInput
                            layout="stack"
                            name="confirmation"
                            type="text"
                            autocomplete="off"
                            autofocus
                            pattern={user.username}
                            title="Type your username exactly as shown."
                            value={deleteForm?.get("confirmation")}
                            zodField={deleteAccountSchema.shape.confirmation}
                            errors={confirmationErrors}
                        >
                            <Fragment slot="label">
                                Type <strong>{user.username}</strong> to confirm
                            </Fragment>
                        </FieldInput>
                        <button
                            class="btn btn-danger btn-md w-full"
                            type="submit"
                        >
                            Delete account
                        </button>
                    </form>
                </DialogDrawer>
            )}
        </section>
    )}
</BaseLayout>
