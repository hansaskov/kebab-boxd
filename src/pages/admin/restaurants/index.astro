---
import { adminSidebarMenuSections } from "@src/data/sidebar-menu-sections";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import PagedSection from "@src/components/PagedSection.astro";
import RelativeTime from "@src/components/RelativeTime.astro";
import SuggestionDecision from "@src/components/SuggestionDecision.astro";
import TabNav from "@src/components/TabNav.astro";
import { can } from "@src/auth/permissions";
import { restaurantStatuses, type RestaurantStatus } from "@src/db/schema";
import { profileHref, restaurantHref } from "@src/hrefs";
import { firstPageHref, parsePageRequest } from "@src/pagination";

const session = Astro.locals.session;

if (!session) {
  return Astro.redirect("/login");
}

if (!can(session.user, "admin-console:view")) {
  return Astro.rewrite("/403");
}

const status = restaurantStatuses.find((option) => option === Astro.url.searchParams.get("status")) ?? "pending";
const { restaurants } = Astro.locals.db.queries;
const [page, counts] = await Promise.all([
  restaurants.listByStatus(status, parsePageRequest(Astro.url)),
  restaurants.countByStatus(),
]);

const statusLabels: Record<RestaurantStatus, string> = { pending: "Waiting", approved: "Approved", rejected: "Rejected" };
const statusTabs = (["pending", "approved", "rejected"] as const).map((option) => ({
  label: statusLabels[option],
  count: counts[option],
  href: firstPageHref(Astro.url, { status: option === "pending" ? undefined : option }),
  current: option === status,
}));
const emptyMessages: Record<RestaurantStatus, string> = {
  pending: "No suggestions are waiting.",
  approved: "No restaurants are approved.",
  rejected: "No suggestions are rejected.",
};
---

<BaseLayout
  title="Restaurants"
  description="Approve or reject the restaurants that users suggest"
  prefetchUrls={["/admin", "/admin/users"]}
  sidebarMenuSections={adminSidebarMenuSections()}
>
  <h1>Restaurants</h1>

  <TabNav class="mt-4" aria-label="Filter restaurants" tabs={statusTabs} />

  <PagedSection class="mt-4" aria-label="Restaurants" page={page} empty={emptyMessages[status]}>
    <ul class="divide-y divide-line rounded-box border border-line bg-surface">
      {page.items.map((restaurant) => (
        <li class="flex flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center">
          <div class="min-w-0 flex-1">
            <a class="field-label block truncate link-hover" href={restaurantHref(restaurant.id)}>{restaurant.name}</a>
            <p class="t-body-sm truncate text-fg-muted">
              {[restaurant.location.addressLine1, restaurant.location.city, restaurant.location.country].filter(Boolean).join(", ")}
            </p>
            <p class="t-body-sm text-fg-muted">
              {restaurant.suggester ? (
                <a class="link-hover" href={profileHref(restaurant.suggester.username)}>{restaurant.suggester.fullname}</a>
              ) : (
                "Added by an admin"
              )}
              {" · "}
              <RelativeTime date={restaurant.createdAt} />
            </p>
          </div>
          <SuggestionDecision class="shrink-0" restaurantId={restaurant.id} status={restaurant.status} />
        </li>
      ))}
    </ul>
  </PagedSection>
</BaseLayout>
