---
import BaseLayout from "@src/layouts/BaseLayout.astro";
import TabNav from "@src/components/TabNav.astro";
import { can } from "@src/auth/permissions";
import { adminTabs } from "@src/data/admin-tabs";

const session = Astro.locals.session;

if (!session) {
  return Astro.redirect("/login");
}

if (!can(session.user, "admin-console:view")) {
  return Astro.rewrite("/403");
}

const [users, restaurants] = await Promise.all([
  Astro.locals.db.users.countByFilter(),
  Astro.locals.db.restaurants.countByStatus(),
]);

const userGroups = [
  { label: "Users", count: users.all, href: "/admin/users" },
  { label: "Admins", count: users.admin, href: "/admin/users?filter=admin" },
  { label: "Banned", count: users.banned, href: "/admin/users?filter=banned" },
];

const restaurantGroups = [
  { label: "Waiting", count: restaurants.pending, href: "/admin/restaurants" },
  { label: "Approved", count: restaurants.approved, href: "/admin/restaurants?status=approved" },
  { label: "Rejected", count: restaurants.rejected, href: "/admin/restaurants?status=rejected" },
];
---

<BaseLayout
  title="Admin console"
  description="Manage the users and restaurants of Kebab Boxd"
  prefetchUrls={["/admin/users", "/admin/restaurants"]}
>
  <TabNav aria-label="Admin console" tabs={adminTabs(Astro.url.pathname)} />

  <h1 class="mt-6">Admin console</h1>

  {[
    { title: "Users", groups: userGroups },
    { title: "Restaurants", groups: restaurantGroups },
  ].map((section) => (
    <section class="mt-8">
      <h2>{section.title}</h2>
      <ul class="t-body-sm mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
        {section.groups.map((group) => (
          <li>
            <a class="block rounded-box border border-line bg-surface p-3 hover:bg-active" href={group.href}>
              <span class="block text-fg-muted">{group.label}</span>
              <span class="t-body block font-medium">{group.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
