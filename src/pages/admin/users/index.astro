---
import { Search } from "@lucide/astro";
import { adminSidebarMenuSections } from "@src/data/sidebar-menu-sections";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import Pagination from "@src/components/Pagination.astro";
import { adminUserHref } from "@src/actions/admin";
import { can } from "@src/auth/permissions";
import { userFilters, type UserFilter } from "@src/db/queries/users";
import { formatExactTime, formatRelativeTime } from "@src/format/relative-time";
import { firstPageFields, firstPageHref, pageNavigation, parsePageRequest } from "@src/pagination";
import { parseUserListCriteria, searchMaxLength } from "@src/validation/user-list-criteria";

const session = Astro.locals.session;

if (!session) {
  return Astro.redirect("/login");
}

if (!can(session.user, "admin-console:view")) {
  return Astro.rewrite("/403");
}

const criteria = parseUserListCriteria(Astro.url.searchParams);
const { search, filter } = criteria;

const page = await Astro.locals.db.queries.users.list(criteria, parsePageRequest(Astro.url));
const users = page.items;
const navigation = pageNavigation(Astro.url, page);

const filterLabels: Record<UserFilter, string> = { all: "All", admin: "Admins", banned: "Banned" };
const filterOptions = userFilters.map((option) => ({
  filter: option,
  label: filterLabels[option],
  href: firstPageHref(Astro.url, { filter: option === "all" ? undefined : option }),
}));

const emptyGroupMessages: Record<UserFilter, string> = {
  all: "There are no users.",
  admin: "There are no admins.",
  banned: "No users are banned.",
};
const emptyMessage =
  page.isPastEnd
    ?"There are no users on this page."
    : search
      ? `No users match “${search}”.`
      : emptyGroupMessages[filter];
---

<BaseLayout
  title="Users"
  description="Search and manage the users of Kebab Boxd"
  includeSidebar={true}
  prefetchUrls={["/admin", "/"]}
  session={session}
  user={session.user}
  sidebarMenuSections={adminSidebarMenuSections()}
>
  <h1>Users</h1>

  <form class="mt-4 flex gap-2" method="get" action={Astro.url.pathname} role="search">
    <label class="sr-only" for="user-search">Search users</label>
    <input
      id="user-search"
      class="input"
      type="search"
      name="q"
      value={search}
      maxlength={searchMaxLength}
      placeholder="Name, username or email"
    />
    {firstPageFields(Astro.url, { q: undefined }).map(([name, value]) => (
      <input type="hidden" name={name} value={value} />
    ))}
    <button class="btn btn-secondary btn-md shrink-0" type="submit">
      <Search size={16} aria-hidden="true" /><span class="max-sm:sr-only">Search</span>
    </button>
  </form>

  <nav class="mt-4 flex flex-wrap gap-2" aria-label="Filter users">
    {filterOptions.map((option) => (
      <a
        class:list={["btn btn-sm", option.filter === filter ? "btn-primary" : "btn-secondary"]}
        href={option.href}
        aria-current={option.filter === filter ? "page" : undefined}
      >
        {option.label}
      </a>
    ))}
  </nav>

  <section class="mt-6" aria-label="Users">
    {users.length === 0 ? (
      <p class="t-body text-fg-muted">{emptyMessage}</p>
    ) : (
      <>
        <p class="t-body-sm text-fg-muted">{page.total} {page.total === 1 ? "user" : "users"}</p>
        <div class="settings-card mt-3">
          <ul>
            {users.map((user) => (
              <li>
                <a class="settings-link" href={adminUserHref(user.username)}>
                  <span>
                    <span class="field-label block truncate">{user.fullname}</span>
                    <span class="t-body-sm block truncate text-fg-muted">@{user.username} · {user.email}</span>
                  </span>
                  <span class="flex items-center gap-2">
                    {user.role === "admin" && <span class="tag">Admin</span>}
                    {user.bannedAt && <span class="tag text-danger">Banned</span>}
                    <time
                      class="t-body-sm text-fg-muted max-sm:hidden"
                      datetime={user.createdAt.toISOString()}
                      title={formatExactTime(user.createdAt)}
                    >
                      Joined {formatRelativeTime(user.createdAt)}
                    </time>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </>
    )}
    {navigation && <Pagination id="user-pages" class="mt-4" aria-label="User pages" navigation={navigation} />}
  </section>
</BaseLayout>
