---
import BaseLayout from "@src/layouts/BaseLayout.astro";
import PagedSection from "@src/components/PagedSection.astro";
import RelativeTime from "@src/components/RelativeTime.astro";
import SearchForm from "@src/components/SearchForm.astro";
import TabNav from "@src/components/TabNav.astro";
import { can } from "@src/auth/permissions";
import { adminTabs } from "@src/data/admin-tabs";
import { adminUserHref, feedHref, signInHref } from "@src/hrefs";
import { userFilters, type UserFilter } from "@src/db/users";
import { firstPageHref, parsePageRequest } from "@src/pagination";
import { parseOption, parseSearch } from "@src/validation/search-params";

const session = Astro.locals.session;

if (!session) {
  return Astro.redirect(signInHref(Astro.url, "admin"));
}

if (!can(session.user, "admin-console:view")) {
  return Astro.rewrite("/403");
}

const search = parseSearch(Astro.url.searchParams);
const filter = parseOption(Astro.url.searchParams, "filter", userFilters, "all");

const page = await Astro.locals.db.users.list(search, filter, parsePageRequest(Astro.url));

const filterLabels: Record<UserFilter, string> = { all: "All", admin: "Admins", banned: "Banned" };
const filterTabs = userFilters.map((option) => ({
  label: filterLabels[option],
  href: firstPageHref(Astro.url, { filter: option === "all" ? undefined : option }),
  current: option === filter,
}));

const emptyGroupMessages: Record<UserFilter, string> = {
  all: "There are no users.",
  admin: "There are no admins.",
  banned: "No users are banned.",
};
const emptyMessage = search ? `No users match “${search}”.` : emptyGroupMessages[filter];
---

<BaseLayout
  title="Users"
  description="Search and manage the users of Kebab Boxd"
  prefetchUrls={["/admin", feedHref]}
>
  <TabNav aria-label="Admin console" tabs={adminTabs(Astro.url.pathname)} />

  <h1 class="mt-6">Users</h1>

  <SearchForm class="mt-4" id="user-search" label="Search users" value={search} placeholder="Name, username or email" />

  <TabNav class="mt-4" aria-label="Filter users" tabs={filterTabs} />

  <PagedSection class="mt-6" aria-label="Users" page={page} empty={emptyMessage}>
    <p class="t-body-sm text-fg-muted">{page.total} {page.total === 1 ? "user" : "users"}</p>
    <ul class="list mt-3">
      {page.items.map((user) => (
        <li class="list-row">
          <div class="min-w-0 flex-1">
            <a class="list-row-link field-label block truncate" href={adminUserHref(user.username)}>{user.fullname}</a>
            <p class="t-body-sm truncate text-fg-muted">@{user.username} · {user.email}</p>
          </div>
          {user.role === "admin" && <span class="tag">Admin</span>}
          {user.bannedAt && <span class="tag text-danger">Banned</span>}
          <span class="t-body-sm shrink-0 text-fg-muted max-sm:hidden">Joined <RelativeTime date={user.createdAt} /></span>
        </li>
      ))}
    </ul>
  </PagedSection>
</BaseLayout>
