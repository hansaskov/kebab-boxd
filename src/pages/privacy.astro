---
import { DATA_CONTROLLER_EMAIL, DATA_CONTROLLER_NAME } from "astro:env/server";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import { authorizationCookieMaxAgeSeconds, returnPathCookieName } from "@src/auth/oauth";
import { googleCookieNames } from "@src/auth/providers/google";
import { sessionCookieName } from "@src/auth/session";
import { settingsSectionDetails, type SettingsSection } from "@src/data/settings-sections";
import { settingsHref } from "@src/hrefs";
import { finishedSuggestionRetentionSeconds, historyRetentionSeconds, inactivityTimeoutSeconds } from "@src/data/retention-periods";

const session = Astro.locals.session;

const days = (seconds: number) => `${seconds / (60 * 60 * 24)} days`;
const minutes = (seconds: number) => `${seconds / 60} minutes`;

const cookies = [
  { name: sessionCookieName, purpose: "Keeps you signed in.", lifetime: `${days(inactivityTimeoutSeconds)} after your last visit` },
  { name: googleCookieNames.state, purpose: "Protects sign-in with Google.", lifetime: `after ${minutes(authorizationCookieMaxAgeSeconds)}` },
  { name: googleCookieNames.codeVerifier, purpose: "Protects sign-in with Google.", lifetime: `after ${minutes(authorizationCookieMaxAgeSeconds)}` },
  { name: returnPathCookieName, purpose: "Brings you back to the page you signed in from.", lifetime: `after ${minutes(authorizationCookieMaxAgeSeconds)}` },
];

const rights: { text: string; section: SettingsSection }[] = [
  { text: "Download all your data", section: "data" },
  { text: "Correct your profile", section: "profile" },
  { text: "Make your profile private", section: "profile" },
  { text: "Remove your location", section: "location" },
  { text: "Delete your account and data", section: "data" },
];
---

<BaseLayout
  title="Privacy"
  description="How Kebab Boxd uses your personal data"
  prefetchUrls={session ? ["/", settingsHref(session.user.username, "data")] : ["/login"]}
>
  <h1>Privacy</h1>

  <section class="mt-8">
    <h2>Who is responsible</h2>
    <p class="t-body mt-2">
      {DATA_CONTROLLER_NAME} is responsible for your personal data on Kebab Boxd.
      Email <a class="link" href={`mailto:${DATA_CONTROLLER_EMAIL}`}>{DATA_CONTROLLER_EMAIL}</a> with any question about your data.
    </p>
  </section>

  <section class="mt-8">
    <h2>What we store and why</h2>
    <ul class="t-body mt-2 list-disc space-y-2 pl-5">
      <li>
        <strong>Your Google account:</strong> your name, email address and Google account ID.
        We need them to create your account and sign you in.
      </li>
      <li>
        <strong>Your profile:</strong> your username, picture, pronouns and bio, if you add them.
        Anyone can see them, also people who are not signed in.
      </li>
      <li>
        <strong>Your location:</strong> the coordinates you save in your settings, if you do.
        We use them to start the map where you are. No one else can see them, not even an admin.
      </li>
      <li>
        <strong>What you do on Kebab Boxd:</strong> your reviews, pictures, likes, follows, follow requests, favorites, bucket list and the restaurants you suggest.
        Anyone can see your reviews and their pictures, your favorites, your bucket list, who you follow and who follows you, also people who are not signed in.
        If you make your profile private, only the people who follow you and the admins can see your reviews, and you approve each new follower.
        We remove the camera details from every picture you upload, such as the place where it was taken.
      </li>
      <li>
        <strong>What you do as an admin:</strong> the cities you search for restaurants and when you update the city list.
        Other admins can see who searched each city.
      </li>
      <li>
        <strong>Your notifications:</strong> who followed you, asked to follow you, approved your follow request or liked your reviews, the decisions on the restaurants you suggest,
        the city searches you started, whether you have read them, and which kinds you want. Only you can see your notifications.
      </li>
      <li>
        <strong>Your devices:</strong> when each device signed in, and which pages it opened and when.
        We use this to keep your account secure and to show you where you are signed in.
        We do not store your IP address or browser details.
      </li>
      <li>
        <strong>A form that could not be saved:</strong> what you typed, until the next page opens,
        so that you do not have to type it again. We never keep the files you chose.
      </li>
    </ul>
    <p class="t-body mt-3">
      We need this data to give you the service you signed up for.
      We keep the device history because we have a legitimate interest in protecting your account.
    </p>
  </section>

  <section class="mt-8">
    <h2>What admins see</h2>
    <p class="t-body mt-2">
      Admins look after Kebab Boxd. To stop abuse, such as a review that breaks the law, and to help you when you ask, they can see:
    </p>
    <ul class="t-body mt-2 list-disc space-y-2 pl-5">
      <li>your email address, and find your account by it</li>
      <li>all your reviews, also those that are hidden or that your private profile shares only with your followers</li>
      <li>your devices: when each one signed in, and which pages it opened and when</li>
      <li>which kinds of notifications you want</li>
      <li>the restaurants you suggest</li>
    </ul>
    <p class="t-body mt-3">
      Admins can also change your profile, also whether it is private, and which notifications you get. They can sign out your devices, delete your reviews and ban your account.
      They cannot see your location, your notifications or your follow requests.
      We have a legitimate interest in this: it keeps Kebab Boxd safe.
    </p>
  </section>

  <section class="mt-8">
    <h2>Cookies</h2>
    <p class="t-body mt-2">
      We only use cookies that the site needs to work. We do not use cookies for tracking or advertising, so we do not ask for your consent.
    </p>
    <ul class="t-body mt-3 list-disc space-y-2 pl-5">
      {cookies.map((cookie) => (
        <li>
          <code>{cookie.name}</code>: {cookie.purpose} Deleted {cookie.lifetime}.
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-8">
    <h2>Who else gets your data</h2>
    <p class="t-body mt-2">
      Google gets to know that you sign in to Kebab Boxd. Read the <a class="link" href="https://policies.google.com/privacy">Google privacy policy</a>.
      The maps show tiles from <a class="link" href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>,
      so the OpenStreetMap Foundation gets your IP address when you open a map. Read the
      <a class="link" href="https://osmfoundation.org/wiki/Privacy_Policy">OpenStreetMap privacy policy</a>.
      When you suggest a restaurant, our server opens the Google Maps link you send and asks OpenStreetMap for the address of the restaurant.
      When an admin searches a city, our server asks OpenStreetMap for the kebab restaurants around it.
      OpenStreetMap and Google never get to know who asked.
      We do not sell your data or share it with advertisers.
    </p>
  </section>

  <section class="mt-8">
    <h2>How long we keep your data</h2>
    <ul class="t-body mt-2 list-disc space-y-2 pl-5">
      <li>Your account and everything you post: until you delete your account.</li>
      <li>A notification: until the follow, like, review or decision it is about is undone, or until you delete your account.</li>
      <li>A follow request: until it is approved, declined or taken back, or until you or the other user delete the account.</li>
      <li>Who started a city search or a city list update: until you delete your account. The search itself stays.</li>
      <li>A Google Maps link you suggest: until it becomes a restaurant, or {days(finishedSuggestionRetentionSeconds)} after we could not use it.</li>
      <li>A signed-in device: {days(inactivityTimeoutSeconds)} after its last use, or when you sign it out.</li>
      <li>The page history of a device: {days(historyRetentionSeconds)}, or less if the device is signed out first.</li>
      <li>A banned account: as long as the ban lasts, so that the person cannot sign up again.</li>
    </ul>
  </section>

  <section class="mt-8">
    <h2>Where the data comes from</h2>
    <p class="t-body mt-2">
      The maps, the addresses and the restaurants that city searches find come from
      <a class="link" href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors</a>,
      under the <a class="link" href="https://opendatacommons.org/licenses/odbl/">Open Database License</a>.
      The list of cities comes from <a class="link" href="https://www.geonames.org/">GeoNames</a>,
      under the <a class="link" href="https://creativecommons.org/licenses/by/4.0/">Creative Commons Attribution 4.0 License</a>.
    </p>
  </section>

  <section class="mt-8">
    <h2>Your rights</h2>
    <ul class="t-body mt-2 list-disc space-y-2 pl-5">
      {rights.map((right) => (
        <li>
          {right.text}:{" "}
          {session
            ? <a class="link" href={settingsHref(session.user.username, right.section)}>Settings, {settingsSectionDetails[right.section].label}</a>
            : `Settings, ${settingsSectionDetails[right.section].label}`}.
        </li>
      ))}
      <li>
        Object to how we use your data, or ask us to limit it: email <a class="link" href={`mailto:${DATA_CONTROLLER_EMAIL}`}>{DATA_CONTROLLER_EMAIL}</a>.
      </li>
      <li>Complain to the data protection authority in the EU country where you live or work.</li>
    </ul>
  </section>
</BaseLayout>
