---
import BaseLayout from "@src/layouts/BaseLayout.astro";
Astro.response.status = 401 
export const prerender = true;
---

<BaseLayout
  title="401: Not Authorized"
  description="You do not have sufficient authorization to acces this page"
  includeSidebar={false}
  prefetchUrls={["/"]}
>
  <div class="text-center">
    <h1 class="text-9xl font-bold mb-4">🫤</h1>
    <h1 class="text-9xl font-bold mb-2">401</h1>
    <h3 class="text-2xl">You do not have sufficient permissions to acces this page</h3>
    <a class="btn btn-accent mt-9" href="/">Home</a>
  </div>
</BaseLayout>
