---
import BaseLayout from "@src/layouts/BaseLayout.astro";
import PagedSection from "@src/components/PagedSection.astro";
import PersonList from "@src/components/PersonList.astro";
import SearchForm from "@src/components/SearchForm.astro";
import { parsePageRequest } from "@src/pagination";
import { parseSearch } from "@src/validation/search-params";

const session = Astro.locals.session;
if (!session) {
  return Astro.redirect("/login");
}

const search = parseSearch(Astro.url.searchParams);
const page = search ? await Astro.locals.db.users.search(search, session.user.id, parsePageRequest(Astro.url)) : undefined;
---

<BaseLayout title="People" description="Find people to follow on Kebab Boxd" prefetchUrls={["/"]}>
  <h1>People</h1>

  <SearchForm class="mt-4" id="people-search" label="Search people" value={search} placeholder="Name or username" />

  {page && (
    <PagedSection class="mt-4" aria-label="People" page={page} empty={`No one matches “${search}”.`}>
      <PersonList people={page.items} viewer={session.user} />
    </PagedSection>
  )}
</BaseLayout>
