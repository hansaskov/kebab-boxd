---
import { Search } from "@lucide/astro";
import { actions } from "astro:actions";
import BaseLayout from "@src/layouts/BaseLayout.astro";
import PagedSection from "@src/components/PagedSection.astro";
import SearchForm from "@src/components/SearchForm.astro";
import TabNav from "@src/components/TabNav.astro";
import { successToast } from "@src/actions/toast";
import LoginDialog from "@src/auth/LoginDialog.astro";
import { loginDialogId } from "@src/auth/login-reasons";
import { regionAndCountry } from "@src/cities/country";
import { noCityText } from "@src/cities/geonames";
import MapView from "@src/map/MapView.astro";
import { openedView } from "@src/map/clusters";
import { distanceInMeters, formatOffset } from "@src/map/coordinates";
import { defaultMapZoom, exploreListRows, exploreMapCells, exploreMoves, exploreView, exploreViewport, exploreZoomStep, homeOf, parseMapView } from "@src/map/explore";
import { zoomedIn, zoomedOut, type MapView as View } from "@src/map/viewport";
import RestaurantList from "@src/restaurants/RestaurantList.astro";
import { parsePageRequest } from "@src/pagination";
import { plural } from "@src/plural";
import { exploreCityHref, exploreHref, restaurantHref, searchHref } from "@src/hrefs";
import { parseId, parseSearch, searchMaxLength } from "@src/params";

const params = Astro.url.searchParams;
const query = parseSearch(params);
const chosenCityId = parseId(params.get("city") ?? undefined);
const isLucky = params.has("lucky");
const requested = parseMapView(params, defaultMapZoom);
const page = parsePageRequest(Astro.url, exploreListRows);

const { db } = Astro.locals;
const { lucky, nearby } = await db.load({
	lucky: isLucky ? db.restaurants.feelLucky(query, chosenCityId, Math.random()) : undefined,
	nearby: db.restaurants.explore({ search: query, cityId: chosenCityId, requested, page }, db.viewer),
});
const session = await Astro.locals.session();
const home = session ? homeOf(session.user) : undefined;
const isVisitor = !session;
if (lucky?.restaurant) return Astro.redirect(restaurantHref(lucky.restaurant.id));
if (lucky?.city) return Astro.redirect(exploreCityHref(query, lucky.city.id));

const mapHref = (to: View) => exploreHref(exploreView(to, isVisitor));
const { cities, city, view, clusters, mostReviewed } = nearby;

function exploreMap(shown: View) {
	const map = exploreViewport(shown);

	const zoomTo = (zoom: number | undefined) => zoom === undefined ? undefined : mapHref({ center: map.center, zoom });

	return {
		map,
		navigation: {
			zoomIn: zoomTo(zoomedIn(map.zoom, exploreZoomStep)),
			zoomOut: zoomTo(zoomedOut(map.zoom, exploreZoomStep)),
			grid: exploreMapCells,
			moves: exploreMoves(map).map(({ column, row, center }) => ({
				column,
				row,
				href: mapHref({ center, zoom: map.zoom }),
				label: `Move ${formatOffset(map.center, center)}`,
			})),
		},
		markers: clusters.map((cluster) =>
			cluster.count === 1
				? { coordinates: cluster.center, href: restaurantHref(cluster.best.id), label: cluster.best.name }
				: { coordinates: cluster.center, href: mapHref(openedView(cluster, map)), label: `${cluster.best.name} and ${cluster.count - 1} more`, count: cluster.count },
		),
		isAtHome: home !== undefined && distanceInMeters(home, map.center) < 1,
		center: `${map.center.latitude.toFixed(6)}, ${map.center.longitude.toFixed(6)}`,
	};
}

const explored = view && exploreMap(view);

const mostReviewedRows = (mostReviewed?.items ?? []).map((restaurant) => ({
	...restaurant,
	details: [restaurant.location.city, plural(restaurant.reviewCount, "review")],
}));

const problem =
	query && !city
		? noCityText(query)
		: isLucky
			? "There are no restaurants yet."
			: undefined;

const toast = successToast(Astro.locals, actions.updateLocation, { title: "Location saved", text: "The map starts here now." });
---

<BaseLayout session={session} title="Explore" description="Kebab restaurants on a map" prefetchUrls={[searchHref("restaurants")]} toast={toast}>
	{explored ? (
		<>
			<h1 class="sm:sr-only">Explore</h1>
			<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-3 sm:mt-0">
				<SearchForm class="w-full" id="explore-city" label="Find a city" value={query} placeholder="Search for a city near you" />
				{!explored.isAtHome && (
					<div class="t-body-sm ms-auto flex flex-wrap items-center gap-x-4 gap-y-1 max-sm:order-last">
						{home && <a class="link" href={exploreHref({ center: home, zoom: explored.map.zoom })}>Back to your location</a>}
						{session ? (
							<form method="post" action={actions.updateLocation}>
								<input type="hidden" name="currentUsername" value={session.user.username} />
								<input type="hidden" name="location" value={explored.center} />
								<button class="link cursor-pointer" type="submit">Set this as your location</button>
							</form>
						) : (
							<>
								<button class="link cursor-pointer" type="button" commandfor={loginDialogId("set-location")} command="show-modal">Set this as your location</button>
								<LoginDialog reason="set-location" returnTo={Astro.url} />
							</>
						)}
					</div>
				)}
				{problem && <p class="t-body-sm w-full text-fg-muted">{problem}</p>}
				{cities.length > 1 && (
					<TabNav
						class="w-full"
						aria-label="Cities"
						tabs={cities.map((match) => ({
							label: `${match.name}, ${regionAndCountry(match)}`,
							href: exploreCityHref(query, match.id),
							current: match.id === city?.id,
						}))}
					/>
				)}
			</div>

			<MapView class="mt-4" viewport={explored.map} markers={explored.markers} here={home} navigation={explored.navigation} />

			{mostReviewed && (
				<PagedSection class="mt-8" aria-label="Most reviewed on the map" page={mostReviewed} fixedRows={exploreListRows} empty="There are no restaurants on this part of the map.">
					<h2 slot="heading" class="mb-3">Most reviewed on the map</h2>
					<RestaurantList restaurants={mostReviewedRows} />
				</PagedSection>
			)}
		</>
	) : (
		<section class="mx-auto flex min-h-[60dvh] max-w-xl flex-col items-center justify-center text-center">
			<h1 class="sr-only">Explore</h1>
			<p class="text-5xl font-semibold tracking-tight select-none sm:text-6xl" aria-hidden="true">
				Kebab <span class="text-brand-text">Boxd</span>
			</p>
			<form class="mt-8 w-full" method="get" action={Astro.url.pathname} role="search">
				<label class="sr-only" for="explore-start">Search for a city near you</label>
				<div class="relative">
					<Search class="pointer-events-none absolute start-5 top-1/2 -translate-y-1/2 text-fg-muted" size={20} aria-hidden="true" />
					<input
						id="explore-start"
						class="input h-13 rounded-full ps-13 pe-5 shadow-lift"
						type="search"
						name="q"
						value={query}
						maxlength={searchMaxLength}
						placeholder="Search for a city near you"
						autocomplete="off"
						autofocus
						aria-describedby={problem ? "explore-start-problem" : undefined}
					/>
				</div>
				{problem && <p id="explore-start-problem" class="t-body-sm mt-3 text-fg-muted">{problem}</p>}
				<div class="mt-7 flex flex-wrap justify-center gap-3">
					<button class="btn btn-secondary btn-md" type="submit">Search</button>
					<button class="btn btn-secondary btn-md" type="submit" name="lucky" value="">I’m feeling lucky</button>
				</div>
			</form>
		</section>
	)}
</BaseLayout>
