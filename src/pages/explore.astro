---
import BaseLayout from "@src/layouts/BaseLayout.astro";
import MapView from "@src/components/MapView.astro";
import RestaurantList from "@src/components/RestaurantList.astro";
import { defaultMapCenter, defaultMapZoom, exploreMapSize, mapMarkerLimit, nearbyRestaurantCount } from "@src/data/map";
import { formatDistance } from "@src/format/distance";
import { exploreHref, restaurantHref, searchHref, settingsHref } from "@src/hrefs";
import { distanceInMeters, type Coordinates } from "@src/map/coordinates";
import { maxZoom, minZoom, viewport } from "@src/map/viewport";
import { parseMapView } from "@src/validation/map-view";

const session = Astro.locals.session;

// A Visitor has no location of their own, so their map starts at the default center.
const home: Coordinates | undefined =
	session && session.user.latitude !== null && session.user.longitude !== null
		? { latitude: session.user.latitude, longitude: session.user.longitude }
		: undefined;
const view = parseMapView(Astro.url.searchParams, { center: home ?? defaultMapCenter, zoom: defaultMapZoom });
const map = viewport(view.center, view.zoom, exploreMapSize);

const { restaurants } = Astro.locals.db;
const [pins, nearest] = await Promise.all([
	restaurants.listNearest(map.center, mapMarkerLimit, map.bounds),
	restaurants.listNearest(map.center, nearbyRestaurantCount),
]);

const controls = {
	zoomIn: map.zoom < maxZoom ? exploreHref({ center: map.center, zoom: map.zoom + 1 }) : undefined,
	zoomOut: map.zoom > minZoom ? exploreHref({ center: map.center, zoom: map.zoom - 1 }) : undefined,
	pan: {
		north: exploreHref({ center: map.panned("north"), zoom: map.zoom }),
		south: exploreHref({ center: map.panned("south"), zoom: map.zoom }),
		east: exploreHref({ center: map.panned("east"), zoom: map.zoom }),
		west: exploreHref({ center: map.panned("west"), zoom: map.zoom }),
	},
};
const markers = pins.map((pin) => ({
	coordinates: pin,
	href: restaurantHref(pin.restaurant.id),
	label: pin.restaurant.name,
}));
const nearby = nearest.map((pin) => ({
	...pin.restaurant,
	details: [formatDistance(distanceInMeters(map.center, pin)), pin.city],
}));
const isAtHome = home !== undefined && distanceInMeters(home, map.center) < 1;
const showsLocationLink = session !== null && !isAtHome;
---

<BaseLayout
	title="Explore"
	description="Kebab restaurants on a map"
	prefetchUrls={[controls.zoomIn, controls.zoomOut, searchHref("restaurants")].filter((href) => href !== undefined)}
>
	<div class="flex flex-wrap items-baseline justify-between gap-2">
		<h1 class="sm:sr-only">Explore</h1>
		{home && !isAtHome && (
			<a class="t-body-sm link ms-auto" href={exploreHref({ center: home, zoom: map.zoom })}>Back to your location</a>
		)}
		{session && !home && (
			<a class="t-body-sm link ms-auto" href={settingsHref(session.user.username, "location")}>Set your location</a>
		)}
	</div>

	<MapView class:list={["mt-4", { "sm:mt-0": !showsLocationLink }]} viewport={map} size={exploreMapSize} markers={markers} here={home} controls={controls} />

	<section class="mt-8" aria-labelledby="nearby-heading">
		<h2 id="nearby-heading">Nearby</h2>
		{nearby.length === 0 ? (
			<p class="t-body mt-2 text-fg-muted">There are no restaurants yet.</p>
		) : (
			<RestaurantList class="mt-3" restaurants={nearby} />
		)}
	</section>
</BaseLayout>
