---
import BaseLayout from "@src/layouts/BaseLayout.astro";
---

<BaseLayout
  title="404: Not Found"
  description="Something went wrong"
  includeSidebar={false}
  prefetchUrls={["/"]}
>
  <div class="text-center">
    <h1 class="mb-4">🏝</h1>
    <h1 class="mb-2">404</h1>
    <h3 class="t-subheading">The page you're looking for couldn't be found.</h3>
    <a class="btn btn-primary btn-md mt-9" href="/">Home</a>
  </div>
</BaseLayout>
