---
import "@src/styles.css";
import { Bell, CircleUser, Compass, DoorOpen, Lightbulb, LogIn, Moon, Rss, Search, Settings, Shield, Sun } from "@lucide/astro";
import { actions } from "astro:actions";
import type { ComponentProps } from "astro/types";
import Avatar from "@src/components/Avatar.astro";
import Toast from "@src/components/Toast.astro";
import SpeculationsAPI from "@src/components/SpeculationsAPI.astro";
import { can } from "@src/auth/permissions";
import { failureToast } from "@src/format/action-toast";
import { feedHref, homeHref, profileHref, searchHref, settingsHref, signInHref } from "@src/hrefs";

interface Props extends ComponentProps<typeof SpeculationsAPI> {
  title: string;
  description: string;
  preview?: string;
  ogType?: string;
  class?: string;
  // Without it, the page tells when the last action failed. A page that shows the failure itself passes null.
  toast?: ComponentProps<typeof Toast>["toast"] | null;
  // Reloads the page after this many seconds, for a page that shows work still running.
  refreshSeconds?: number | undefined;
}

const { session } = Astro.locals;
const user = session?.user;
const {
  title,
  description,
  preview = "/preview.webp",
  ogType = "website",
  toast = failureToast(Astro.locals),
  refreshSeconds,
  class: className,
  ...props
} = Astro.props;

const image = new URL(preview, Astro.url);
const unread = user?.unreadNotificationCount ?? 0;

const { pathname } = Astro.url;
const isUnder = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
const current = (href: string) => (pathname === href ? "page" : undefined);

// The bar has the places to browse on the left, and Search on the right beside Notifications and the account.
// The dock shows every icon, and the bar shows only the one of Search.
const links = [
  { name: "Feed", href: feedHref, icon: Rss },
  { name: "Explore", href: "/explore", icon: Compass },
  { name: "Search", href: searchHref(), icon: Search, startsRightGroup: true, hasIconInBar: true },
];

const accountMenu = user && {
  profile: profileHref(user.username),
  settings: settingsHref(user.username),
  // A larger screen shows the menu of the sections beside each one, so it can open the first section directly.
  firstSettingsSection: settingsHref(user.username, "profile"),
  suggest: "/restaurants/suggest",
  admin: can(user, "admin-console:view") ? "/admin" : undefined,
};
// The account button stands for the pages in its menu, since they have no place of their own in the navigation.
const isOnAccountPage =
  accountMenu !== undefined && [accountMenu.profile, accountMenu.settings, accountMenu.suggest, accountMenu.admin].some((href) => href && isUnder(href));
// A Visitor logs in where the account would be, and comes back to the page they are on. The login page needs no link to itself.
const login = !user && pathname !== signInHref() ? signInHref(Astro.url) : undefined;
---

<!doctype html>
<html lang="en" data-theme={session?.theme ?? "light"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {refreshSeconds !== undefined && <meta http-equiv="refresh" content={String(refreshSeconds)} />}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <SpeculationsAPI {...props} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav-list">
        {links.map(({ name, href, icon: Icon, startsRightGroup, hasIconInBar }) => (
          <li class:list={{ "sm:ms-auto": startsRightGroup }}>
            <a class="nav-link" href={href} aria-current={current(href)}>
              <Icon class:list={{ "sm:hidden": !hasIconInBar }} size={20} aria-hidden="true" />
              <span class="max-sm:sr-only">{name}</span>
            </a>
          </li>
        ))}
        {login && (
          <li>
            <a class="nav-link" href={login}>
              <LogIn class="sm:hidden" size={20} aria-hidden="true" />
              <span class="max-sm:sr-only">Login</span>
            </a>
          </li>
        )}
        {session && user && accountMenu && (
          <>
            <li>
              <a class="nav-link" href="/notifications" aria-current={current("/notifications")}>
                <span class="relative">
                  <Bell size={20} aria-hidden="true" />
                  {unread > 0 && (
                    <span
                      class="t-caption absolute -top-2 -right-2.5 grid h-4.5 min-w-4.5 place-items-center rounded-full bg-brand px-1 leading-none font-semibold text-on-brand tabular-nums"
                      aria-hidden="true"
                    >
                      {unread > 99 ? "99+" : unread}
                    </span>
                  )}
                </span>
                <span class="sr-only">Notifications{unread > 0 && `, ${unread} unread`}</span>
              </a>
            </li>
            <li>
              <button
                type="button"
                class="nav-link"
                popovertarget="account-menu"
                style="anchor-name:--account-menu"
                data-current={isOnAccountPage ? "" : undefined}
              >
                <Avatar class="size-8 text-xs" name={user.fullname} picture={user.profilePicture} />
                <span class="sr-only">Account</span>
              </button>
              <ul class="popover-panel menu-list" popover id="account-menu" style="position-anchor:--account-menu">
                <li>
                  <a href={accountMenu.profile} aria-current={current(accountMenu.profile)}>
                    <CircleUser size={16} aria-hidden="true" />
                    <span class="min-w-0">
                      <span class="block truncate leading-tight font-semibold">{user.fullname}</span>
                      <span class="t-caption block truncate leading-tight text-fg-muted">@{user.username}</span>
                    </span>
                  </a>
                </li>
                <li>
                  <a href={accountMenu.suggest} aria-current={current(accountMenu.suggest)}>
                    <Lightbulb size={16} aria-hidden="true" />Suggestions
                  </a>
                </li>
                <li class="md:hidden">
                  <a href={accountMenu.settings} aria-current={current(accountMenu.settings)}>
                    <Settings size={16} aria-hidden="true" />Settings
                  </a>
                </li>
                <li class="max-md:hidden">
                  <a href={accountMenu.firstSettingsSection} aria-current={current(accountMenu.firstSettingsSection)}>
                    <Settings size={16} aria-hidden="true" />Settings
                  </a>
                </li>
                <li>
                  <form method="post" action={actions.session.toggleTheme}>
                    <button type="submit">
                      {session.theme === "dark" ? <Moon size={16} aria-hidden="true" /> : <Sun size={16} aria-hidden="true" />}
                      Theme
                    </button>
                  </form>
                </li>
                {accountMenu.admin && (
                  <li>
                    <a href={accountMenu.admin} aria-current={current(accountMenu.admin)}>
                      <Shield size={16} aria-hidden="true" />Admin console
                    </a>
                  </li>
                )}
                <li class="mt-1 border-t border-line pt-1">
                  <form method="post" action={actions.session.signOut}>
                    <button data-danger type="submit"><DoorOpen size={16} aria-hidden="true" />Sign out</button>
                  </form>
                </li>
              </ul>
            </li>
          </>
        )}
      </ul>
    </nav>

    <main id="main-content" class:list={["mx-auto w-full max-w-page px-gutter pt-5 pb-16", className]}>
      <slot />
    </main>

    <footer class="mt-auto shrink-0 border-t border-line px-gutter py-8">
      <div class="t-caption flex items-center justify-center gap-3 text-fg-muted">
        <a class="link link-hover text-fg-muted" href={homeHref(session)}>Kebab Boxd</a>
        <span class="select-none text-fg-subtle" aria-hidden="true">•</span>
        <span>{new Date().getFullYear()}</span>
        <span class="select-none text-fg-subtle" aria-hidden="true">•</span>
        <a class="link link-hover text-fg-muted" href="/privacy">Privacy</a>
      </div>
    </footer>

    {toast && <Toast toast={toast} />}
  </body>
</html>
