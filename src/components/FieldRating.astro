---
import { Star } from "@lucide/astro";
import type { ComponentProps } from "astro/types";
import type { ZodNumber } from "astro/zod";
import Field from "@src/components/Field.astro";
import type { SubmittedForm } from "@src/actions/outcome";
import { describeField } from "@src/format/field";
import { describeStars, maxStars, toStars } from "@src/format/rating";
import { getConstraintsFromZodSchema } from "@src/validation/constraint";

interface Props extends Omit<ComponentProps<typeof Field>, "field" | "description" | "group"> {
    name: string;
    zodField: ZodNumber;
    label: string;
    selected?: number | undefined;
    // The form as the user sent it when it failed. What they chose replaces the selected rating.
    submitted?: SubmittedForm | undefined;
}

const { name, zodField, selected, submitted, ...props } = Astro.props;
const { min, max, required } = getConstraintsFromZodSchema(zodField);
if (min === undefined || max !== maxStars * 2) {
    throw new Error(`FieldRating "${name}" needs a schema with a minimum and a maximum of ${maxStars * 2}, one for each half star.`);
}

const current = submitted ? Number(submitted.get(name)) || undefined : selected;
const field = describeField({ name, submitted });

// A rating is a number of half stars. An odd rating ends in the first half of a star, an even one in the second half.
// When the half before a rating is below the minimum, its option covers the whole star.
const options = Array.from({ length: max - min + 1 }, (_, i) => min + i).map((rating) => ({
    rating,
    part: rating % 2 === 1 ? "start" : rating - 1 < min ? "whole" : "end",
}));
---

<Field field={field} group {...props}>
    <div
        class="star-rating"
        role="radiogroup"
        aria-labelledby={field.labelId}
        aria-describedby={field.control["aria-describedby"]}
        aria-invalid={field.control["aria-invalid"]}
    >
        {options.map(({ rating, part }) => (
            <label class:list={["star-rating-option", `star-rating-${part}`]}>
                <input
                    class="sr-only"
                    type="radio"
                    name={name}
                    value={rating}
                    checked={current === rating}
                    required={required}
                />
                <span class="sr-only">{describeStars(toStars(rating))}</span>
                <Star class="star-rating-icon" aria-hidden="true" />
            </label>
        ))}
    </div>
</Field>
