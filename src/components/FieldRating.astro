---
import { ChevronDown } from "@lucide/astro";
import type { ComponentProps } from "astro/types";
import type { ZodNumber } from "astro/zod";
import Field from "@src/components/Field.astro";
import type { SubmittedForm } from "@src/actions/outcome";
import { describeField } from "@src/format/field";
import { describeStars, toStars } from "@src/format/rating";
import { getConstraintsFromZodSchema } from "@src/validation/constraint";

interface Props extends Omit<ComponentProps<typeof Field>, "field" | "layout" | "description">, astroHTML.JSX.SelectHTMLAttributes {
    name: string;
    zodField: ZodNumber;
    label: string;
    selected?: number | undefined;
    // The form as the user sent it when it failed. What they chose replaces the selected rating.
    submitted?: SubmittedForm | undefined;
}

const { zodField, selected, label, submitted, class: className, ...props } = Astro.props;
const { min, max, ...constraints } = getConstraintsFromZodSchema(zodField);
if (min === undefined || max === undefined) {
    throw new Error(`FieldRating "${props.name}" needs a schema with a minimum and a maximum.`);
}
const ratings = Array.from({ length: max - min + 1 }, (_, i) => max - i);
const current = submitted ? Number(submitted.get(props.name)) || undefined : selected;
const field = describeField({ ...props, submitted });
---

<Field field={field} label={label}>
    <div class="select">
        <select class:list={["input", className]} {...constraints} {...props} {...field.control}>
            {current === undefined && <option value="" selected disabled>Choose a rating</option>}
            {ratings.map((rating) => (
                <option value={rating} selected={current === rating}>{describeStars(toStars(rating))}</option>
            ))}
        </select>
        <ChevronDown size={16} aria-hidden="true" class="select-icon" />
    </div>
</Field>
