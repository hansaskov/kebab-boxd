---
import type { ComponentProps } from "astro/types";
import Field from "@src/components/Field.astro";
import type { SubmittedForm } from "@src/actions/outcome";
import { describeField } from "@src/format/field";
import { acceptedPictureTypes } from "@src/pictures/store";

interface Props extends Omit<ComponentProps<typeof Field>, "field" | "layout">, astroHTML.JSX.InputHTMLAttributes {
    name: string;
    label: string;
    // The form as the user sent it when it failed. A browser cannot fill in a file input, so only its errors show.
    submitted?: SubmittedForm | undefined;
}

const { label, description, submitted, class: className, ...props } = Astro.props;
const field = describeField({ ...props, description, submitted });
---

<Field field={field} label={label} description={description}>
    <input class:list={["input", className]} type="file" accept={acceptedPictureTypes.join(",")} {...props} {...field.control} />
</Field>
