---
import { Moon, Sun } from "@lucide/astro";
import { actions } from "astro:actions";

const session = Astro.locals.session;
---
{session && (
<form method="post" action={actions.session.toggleTheme}>
  <li>
    <button type="submit">
      {session.theme === "dark" ? <Moon size={16} aria-hidden="true" /> : <Sun size={16} aria-hidden="true" />}
      Theme
    </button>
  </li>
</form>
)}
