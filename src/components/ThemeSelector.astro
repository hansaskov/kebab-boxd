---
import { Moon, Sun } from "@lucide/astro";
import type { Session } from "@src/db/schema";

interface Props {
  session?: Session;
}

const { session } = Astro.props;

const isDark = session?.theme === "dark";
---
{session && (
<form method="post" action="/api/theme">
  <li>
    <button type="submit">
      {isDark ? <Moon size={16} aria-hidden="true" /> : <Sun size={16} aria-hidden="true" />}
      Theme
    </button>
  </li>
</form>
)}
