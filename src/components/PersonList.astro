---
import type { HTMLAttributes } from "astro/types";
import Avatar from "@src/components/Avatar.astro";
import FollowButton from "@src/components/FollowButton.astro";
import { can, type Subject } from "@src/auth/permissions";
import type { Person } from "@src/db/follows";
import { profileHref } from "@src/hrefs";

interface Props extends HTMLAttributes<"ul"> {
  people: Person[];
  viewer: Subject;
}

const { people, viewer, class: className, ...props } = Astro.props;
---

<ul class:list={["list", className]} {...props}>
  {people.map((person) => {
    const isFollowing = person.isFollowedByViewer && can(viewer, "user:unfollow", person);
    const canFollow = !person.isFollowedByViewer && can(viewer, "user:follow", person);
    return (
      <li class="list-row">
        <Avatar class="size-10 text-sm" name={person.fullname} picture={person.profilePicture} />
        <div class="min-w-0 flex-1">
          <a class="list-row-link field-label block truncate" href={profileHref(person.username)}>{person.fullname}</a>
          <p class="t-body-sm truncate text-fg-muted">@{person.username}</p>
        </div>
        {(isFollowing || canFollow) && <FollowButton class="shrink-0" username={person.username} following={isFollowing} />}
      </li>
    );
  })}
</ul>
