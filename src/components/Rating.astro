---
import { Star, StarHalf } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";
import { describeStars, splitStars, toStars } from "@src/format/rating";

interface Props extends HTMLAttributes<"span"> {
  rating: number;
}

const { rating, class: className, ...props } = Astro.props;
const { full, half } = splitStars(rating);
---

<span
  class:list={["inline-flex items-center gap-0.5 text-brand-text", className]}
  role="img"
  aria-label={describeStars(toStars(rating))}
  {...props}
>
  {Array.from({ length: full }, () => <Star size={16} fill="currentColor" aria-hidden="true" />)}
  {half && <StarHalf size={16} fill="currentColor" aria-hidden="true" />}
</span>
