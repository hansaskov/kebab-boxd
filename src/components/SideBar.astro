---
import SideBarHeader from "@src/components/SideBarHeader.astro";
import SideBarFooter from "@src/components/SideBarFooter.astro";
import SideBarMenu from "@src/components/SideBarMenu.astro";
import type { ComponentProps } from "astro/types";

interface Props extends 
    ComponentProps<typeof SideBarFooter>,
    ComponentProps<typeof SideBarMenu>
    {}

const props = Astro.props;
---

<div class="drawer-side z-40">
    <label for="my-drawer" class="drawer-overlay"></label>
    <aside
        class="h-auto min-h-full w-80 bg-base-200 text-base-content flex flex-col border-r border-base-300"
    >
        <SideBarHeader />
        <SideBarMenu {...props} />
        <SideBarFooter {...props} />
    </aside>
</div>