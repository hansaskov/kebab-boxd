---
import type { ComponentProps } from "astro/types";
import type { ZodNullable, ZodString } from "astro/zod";
import Field from "@src/components/Field.astro";
import type { SubmittedForm } from "@src/actions/outcome";
import { describeField } from "@src/format/field";
import { getConstraintsFromZodSchema } from "@src/validation/constraint";

interface Props extends Omit<ComponentProps<typeof Field>, "field">, astroHTML.JSX.InputHTMLAttributes {
    name: string;
    zodField: ZodString | ZodNullable<ZodString>;
    errors?: string[] | undefined;
    // The form as the user sent it when it failed. What they typed replaces the value.
    submitted?: SubmittedForm | undefined;
}

const { zodField, label, description, layout, errors, submitted, value, class: className, ...props } = Astro.props;
const field = describeField({ ...props, description, errors, submitted });
---

<Field field={field} label={label} description={description} layout={layout}>
    {Astro.slots.has("label") && <Fragment slot="label"><slot name="label" /></Fragment>}
    <input
        class:list={["input", className]}
        value={submitted ? submitted.get(props.name) : value}
        {...getConstraintsFromZodSchema(zodField)}
        {...props}
        {...field.control}
    />
</Field>
