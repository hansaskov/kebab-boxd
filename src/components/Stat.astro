---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  label: string;
}

const { label, class: className, ...props } = Astro.props;
---

<div class:list={["rounded-box border border-line bg-surface p-3", className]} {...props}>
  <dt class="text-fg-muted">{label}</dt>
  <dd class="t-body font-medium"><slot /></dd>
</div>
