---
import { ChevronUp, CircleUser, Settings, DoorOpen, Shield } from "@lucide/astro";
import Avatar from "@src/components/Avatar.astro";
import ThemeSelector from "@src/components/ThemeSelector.astro";
import type { ComponentProps } from "astro/types";
import type { SessionWithUser } from "@src/auth/session";
import { can } from "@src/auth/permissions";
import { profileHref, settingsHref } from "@src/hrefs";

interface Props extends ComponentProps<typeof ThemeSelector> {
  user?: NonNullable<SessionWithUser>["user"];
}

const { user } = Astro.props;
---

 {user && (
  <div class="relative p-3 border-t border-line">
    <button
      popovertarget="sidebar-user-menu"
      style="anchor-name:--sidebar-user-menu"
      class="flex items-center gap-3 px-2 py-2 rounded-field hover:bg-active cursor-pointer w-full text-left"
    >
      <Avatar class="size-10" name={user.fullname} picture={user.profilePicture} />
      <div class="flex-1 text-left min-w-0">
        <div class="font-semibold text-sm truncate">{user.fullname}</div>
        <div class="text-xs text-fg-muted truncate">@{user.username}</div>
      </div>
      <ChevronUp size={16} aria-hidden="true" />
    </button>
    <ul
      class="popover-panel menu-list"
      popover
      id="sidebar-user-menu"
    >
      <li><a href={profileHref(user.username)}><CircleUser size={16} aria-hidden="true" />Profile</a></li>
      <li><a href={settingsHref(user.username)}><Settings size={16} aria-hidden="true" />Settings</a></li>
      <ThemeSelector {...Astro.props} />
      {
        can(user, "admin-console:view") && (
          <>
            <li data-menu-title="true">Admin</li>
            <li><a href="/admin" ><Shield size={16} aria-hidden="true" />Admin console</a></li>
          </>
        )
      }
      <form method="post" action="/api/logout" class="border-t border-line pt-1 mt-1">
        <li>
          <button data-danger type="submit"><DoorOpen size={16} aria-hidden="true" />Sign out</button>
        </li>
      </form>
    </ul>
  </div>
 )}
