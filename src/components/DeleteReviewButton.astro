---
import { Trash } from "@lucide/astro";
import { actions } from "astro:actions";
import DialogDrawer from "@src/components/DialogDrawer.astro";

interface Props {
  reviewId: number;
  class?: string;
}

const { reviewId, class: className } = Astro.props;
const dialogId = `delete-review-${reviewId}`;
---

<button class:list={["btn btn-danger btn-md", className]} type="button" commandfor={dialogId} command="show-modal">
  <Trash size={16} aria-hidden="true" />Delete review
</button>
<DialogDrawer id={dialogId} title="Delete this review?" description="The review and its pictures are deleted for good.">
  <form method="post" action={actions.reviews.delete}>
    <input type="hidden" name="reviewId" value={reviewId} />
    <button class="btn btn-danger btn-md w-full" type="submit">Delete review</button>
  </form>
</DialogDrawer>
