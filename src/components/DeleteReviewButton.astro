---
import { Trash } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";
import { deleteReviewDialogId } from "@src/data/dialog-ids";

// Opens the DeleteReviewDialog of the review, which the page renders outside any form, since the dialog has its own.
interface Props extends HTMLAttributes<"button"> {
  reviewId: number;
}

const { reviewId, class: className, ...props } = Astro.props;
---

<button
  class:list={["btn btn-danger btn-md", className]}
  type="button"
  commandfor={deleteReviewDialogId(reviewId)}
  command="show-modal"
  {...props}
>
  <Trash size={16} aria-hidden="true" />Delete review
</button>
