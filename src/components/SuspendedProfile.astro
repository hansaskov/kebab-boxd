---
import type { ComponentProps } from "astro/types";
import FollowButton from "@src/components/FollowButton.astro";

interface Props extends Omit<ComponentProps<typeof FollowButton>, "following"> {
  isFollowing: boolean;
}

const { isFollowing, ...props } = Astro.props;
---

<div class="mt-16 flex flex-col items-center gap-6 text-center">
  <h1 class="t-subheading">This account has been suspended.</h1>
  {isFollowing && <FollowButton following {...props} />}
</div>
