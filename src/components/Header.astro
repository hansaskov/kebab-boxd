---
import { Menu } from "@lucide/astro";

interface Props {
  includeSidebar?: boolean;
}

const { includeSidebar = false } = Astro.props;
---
<header
  class="sticky top-0 z-30 h-16 w-full border-b border-line bg-page/90 backdrop-blur-sm lg:border-b-0 lg:bg-transparent lg:backdrop-blur-none"
>
  <div class="flex h-full items-center gap-2 pl-gutter pr-2.5">
    {
      includeSidebar && (
        <label for="site-nav" class="icon-btn lg:hidden" title="Open menu">
          <Menu size={20} aria-hidden="true" />
        </label>
      )
    }

    <div class:list={["flex flex-1 justify-center lg:hidden", { "justify-start": !includeSidebar }]}>
      <a href="/" class="text-fg text-lg font-bold tracking-tight">Kebab Boxd</a>
    </div>

    <div class="ml-auto flex items-center justify-end"></div>
  </div>
</header>
