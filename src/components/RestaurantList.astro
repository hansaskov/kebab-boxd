---
import { Star } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";
import type { CollectedRestaurant } from "@src/db/queries/profiles";
import { describeStars, formatAverageStars } from "@src/format/rating";

interface Props extends HTMLAttributes<"ul"> {
  restaurants: CollectedRestaurant[];
}

const { restaurants, class: className, ...props } = Astro.props;
---

<ul class:list={["divide-y divide-line rounded-box border border-line bg-surface", className]} {...props}>
  {restaurants.map(({ restaurant }) => (
    <li class="flex items-center justify-between gap-3 px-4 py-3">
      <span class="min-w-0">
        <span class="field-label block truncate">{restaurant.name}</span>
        {restaurant.location.city && <span class="t-body-sm block truncate text-fg-muted">{restaurant.location.city}</span>}
      </span>
      {restaurant.ratingAvg > 0 && (
        <span
          class="t-body-sm flex shrink-0 items-center gap-1 text-fg-muted"
          role="img"
          aria-label={describeStars(formatAverageStars(restaurant.ratingAvg))}
        >
          <Star class="text-brand-text" size={14} fill="currentColor" aria-hidden="true" />
          {formatAverageStars(restaurant.ratingAvg)}
        </span>
      )}
    </li>
  ))}
</ul>
