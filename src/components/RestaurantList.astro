---
import { X } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";
import type { actions } from "astro:actions";
import AverageRating from "@src/components/AverageRating.astro";
import { restaurantHref } from "@src/hrefs";

export interface RestaurantListItem {
  id: number;
  name: string;
  ratingAvg: number;
  details: (string | null | undefined)[];
}

interface Props extends HTMLAttributes<"ul"> {
  restaurants: RestaurantListItem[];
  remove?: {
    action: typeof actions.restaurants.unfavorite | typeof actions.restaurants.removeFromBucketList;
    label: string;
  } | undefined;
}

const { restaurants, remove, class: className, ...props } = Astro.props;
---

<ul class:list={["divide-y divide-line rounded-box border border-line bg-surface", className]} {...props}>
  {restaurants.map((restaurant) => {
    const details = restaurant.details.filter(Boolean).join(" · ");
    return (
      <li class="flex items-center gap-3 pr-2">
        <a class="flex min-w-0 flex-1 items-center justify-between gap-3 py-3 pl-4 hover:bg-active" href={restaurantHref(restaurant.id)}>
          <span class="min-w-0">
            <span class="field-label block truncate">{restaurant.name}</span>
            {details && <span class="t-body-sm block truncate text-fg-muted">{details}</span>}
          </span>
          <AverageRating ratingAvg={restaurant.ratingAvg} />
        </a>
        {remove && (
          <form method="post" action={remove.action}>
            <input type="hidden" name="restaurantId" value={restaurant.id} />
            <button class="icon-btn" type="submit" title={`${remove.label}: ${restaurant.name}`}>
              <X size={16} aria-hidden="true" />
              <span class="sr-only">{remove.label}: {restaurant.name}</span>
            </button>
          </form>
        )}
      </li>
    );
  })}
</ul>
