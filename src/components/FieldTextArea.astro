---
import { getConstraintsFromZodSchmea } from "@src/validation/constraint";
import { ZodNullable, ZodString } from "astro:schema";

interface Props extends astroHTML.JSX.TextareaHTMLAttributes {
    zodField: ZodString | ZodNullable<ZodString>;
    title?: string;
    description: string;
    errors?: string[] | undefined;
}

const props = Astro.props;

const constraints = getConstraintsFromZodSchmea(props.zodField)
const validationString = `Must be ${constraints?.minlength} to ${constraints?.maxlength} characters`;
---

<div class="space-y-2">
    <label class="block text-sm font-medium" for={props.id}>{props.title}</label>
    <textarea
        class:list={[
            "textarea input validator w-full", 
            props.class
        ]}
        {...constraints}
        {...props}>{props.value}</textarea
    >
    <p class="text-sm text-base-content/60">{props.description}</p>
    <p class="validator-hint hidden">{validationString}</p>
    {
        props.errors && (
            <p class="text-xs text-error" role="alert">
                {props.errors.join("\n")}
            </p>
        )
    }
</div>
