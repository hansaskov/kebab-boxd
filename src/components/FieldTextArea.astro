---
import type { ComponentProps } from "astro/types";
import type { ZodNullable, ZodString } from "astro/zod";
import Field from "@src/components/Field.astro";
import type { SubmittedForm } from "@src/actions/outcome";
import { describeField } from "@src/format/field";
import { getConstraintsFromZodSchema } from "@src/validation/constraint";

interface Props extends Omit<ComponentProps<typeof Field>, "field" | "layout">, astroHTML.JSX.TextareaHTMLAttributes {
    name: string;
    zodField: ZodString | ZodNullable<ZodString>;
    label: string;
    // The form as the user sent it when it failed. What they typed replaces the value.
    submitted?: SubmittedForm | undefined;
}

const { zodField, label, description, submitted, value, class: className, ...props } = Astro.props;
const field = describeField({ ...props, description, submitted });
---

<Field field={field} label={label} description={description}>
    <textarea
        class:list={["input", className]}
        {...getConstraintsFromZodSchema(zodField)}
        {...props}
        {...field.control}>{submitted ? submitted.get(props.name) : value}</textarea
    >
</Field>
