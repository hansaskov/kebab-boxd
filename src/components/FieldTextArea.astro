---
import { getConstraintsFromZodSchmea } from "@src/validation/constraint";
import { ZodNullable, ZodString } from "astro:schema";

interface Props extends astroHTML.JSX.TextareaHTMLAttributes {
    zodField: ZodString | ZodNullable<ZodString>;
    title?: string;
    description: string;
    errors?: string[] | undefined;
}

const props = Astro.props;

const constraints = getConstraintsFromZodSchmea(props.zodField)
const fieldId = props.id ?? props.name
---

<div class="settings-row">
    <div class="settings-row-text">
        <label class="field-label" for={fieldId}>{props.title}</label>
        <p class="t-body-sm text-fg-muted">{props.description}</p>
    </div>
    <div class="settings-row-field space-y-2">
        <textarea
            id={fieldId}
            class:list={[
                "input", 
                props.class
            ]}
            {...constraints}
            {...props}>{props.value}</textarea
        >
        {
            props.errors && (
                <p class="t-caption text-danger" role="alert">
                    {props.errors.join("\n")}
                </p>
            )
        }
    </div>
</div>
