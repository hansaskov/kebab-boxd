---
import { X } from "@lucide/astro";
import type { AstroComponent } from "@lucide/astro";

interface ToastBase {
	variant?: "default" | "error";
}

export type Toast =
	| (ToastBase & {
			kind: "text";
			text: string;
			action?: AstroComponent;
	  })
	| (ToastBase & {
			kind: "title";
			title: string;
			text: string;
			action?: AstroComponent;
	  })
	| (ToastBase & {
			kind: "icon";
			icon: AstroComponent;
			text: string;
			action?: AstroComponent;
	  })

interface Props {
	toast?: Toast | undefined
}

const { toast } = Astro.props;
const isError = toast?.variant === "error";
---

{
	toast && (
		<div
			class="animate-[toast-life_5.35s_forwards] fixed bottom-4 left-8 right-8 z-100 flex justify-center pointer-events-none has-checked:hidden motion-reduce:animate-[toast-life-static_5s_forwards] sm:right-4 sm:left-auto sm:justify-end"
			role={isError ? "alert" : "status"}
			aria-live={isError ? "assertive" : "polite"}
		>
			<input
				type="checkbox"
				id="toast-dismiss"
				class="absolute size-px opacity-0"
				tabindex="-1"
				aria-hidden="true"
			/>
			<div class:list={["flex w-full gap-3 rounded-box border p-4 bg-surface text-fg shadow-lift pointer-events-auto sm:w-auto sm:max-w-md", isError ? "border-danger" : "border-line", toast.kind === "title" ? "items-start" : "items-center"]}>
				{toast.kind === "icon" && <toast.icon class="shrink-0" size={20} />}
				<div class="min-w-0 flex-1">
					{toast.kind === "title" && <p class:list={["text-sm font-semibold", isError && "text-danger"]}>{toast.title}</p>}
					<p class="t-body-sm text-fg-muted">{toast.text}</p>
				</div>
				{toast.action && (
					<div class="shrink-0">
						<toast.action />
					</div>
				)}
				<label
					for="toast-dismiss"
					class="shrink-0 cursor-pointer opacity-60 hover:opacity-100"
					aria-label="Dismiss"
				>
					<X size={16} />
				</label>
			</div>
		</div>
	)
}

<style>
	@keyframes toast-life {
		0%,
		93.46% {
			opacity: 1;
			transform: translateY(0);
			visibility: visible;
		}
		100% {
			opacity: 0;
			transform: translateY(0.5rem);
			visibility: hidden;
		}
	}

	@keyframes toast-life-static {
		0%,
		99% {
			opacity: 1;
			visibility: visible;
		}
		100% {
			opacity: 1;
			visibility: hidden;
		}
	}
</style>