---
import { Bookmark, BookmarkCheck, Heart } from "@lucide/astro";
import { actions } from "astro:actions";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"form"> {
  restaurantId: number;
  collection: "favorites" | "bucketList";
  collected: boolean;
}

const { restaurantId, collection, collected, class: className, ...props } = Astro.props;

const variants = {
  favorites: {
    add: actions.restaurants.favorite,
    remove: actions.restaurants.unfavorite,
    label: "Favorite",
  },
  bucketList: {
    add: actions.restaurants.addToBucketList,
    remove: actions.restaurants.removeFromBucketList,
    label: "Bucket list",
  },
};
const variant = variants[collection];
const Icon = collection === "favorites" ? Heart : collected ? BookmarkCheck : Bookmark;
---

<form class:list={["flex", className]} method="post" action={collected ? variant.remove : variant.add} {...props}>
  <input type="hidden" name="restaurantId" value={restaurantId} />
  <button class="btn btn-secondary btn-md w-full" type="submit" aria-pressed={collected ? "true" : "false"}>
    <Icon size={16} fill={collected && collection === "favorites" ? "currentColor" : "none"} aria-hidden="true" />
    {variant.label}
  </button>
</form>
