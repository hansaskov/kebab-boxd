---
import type { ComponentProps } from "astro/types";
import ReviewCard from "@src/components/ReviewCard.astro";
import type { ReviewCard as ReviewCardData } from "@src/db/queries/reviews";

interface Props extends Omit<ComponentProps<typeof ReviewCard>, "review" | "class"> {
  reviews: ReviewCardData[];
  class?: string;
}

const { reviews, class: className, ...props } = Astro.props;
---

<ol class:list={["list", className]}>
  {reviews.map((review) => (
    <li>
      <ReviewCard review={review} {...props} />
    </li>
  ))}
</ol>
