---
import { Heart, Pencil, Star, StarHalf } from "@lucide/astro";
import { actions } from "astro:actions";
import type { HTMLAttributes } from "astro/types";
import Avatar from "@src/components/Avatar.astro";
import { canOn, type Viewer } from "@src/auth/permissions";
import { succeededOn } from "@src/actions/outcome";
import type { ReviewCard } from "@src/db/reviews";
import RelativeTime from "@src/components/RelativeTime.astro";
import { describeStars, starFills, toStars } from "@src/format/rating";
import { maxPicturesPerReview } from "@src/validation/review";
import { editReviewHref, profileHref, restaurantHref, reviewHref } from "@src/hrefs";

interface Props extends HTMLAttributes<"article"> {
  review: ReviewCard;
  viewer: Viewer;
  showAuthor?: boolean;
  showRestaurant?: boolean;
}

const { review, viewer, showAuthor = true, showRestaurant = true, class: className, ...props } = Astro.props;
const { author, restaurant } = review;

const canLike = canOn(viewer, "review:like", review) || (review.isLikedByViewer && canOn(viewer, "review:unlike", review));
const canEdit = canOn(viewer, "review:edit", review);
const justLiked = review.isLikedByViewer && succeededOn(Astro.locals, actions.reviews.like) === review.id;
// The pictures fill the width of the card in one row, a column for each picture a Review may have, so they grow
// with the screen and line up from one card to the next.
const pictureColumns = `grid-template-columns: repeat(${maxPicturesPerReview}, minmax(0, 1fr))`;
---

<article class:list={["p-4 sm:px-5", className]} {...props}>
  <header class="flex items-start gap-3">
    {showAuthor && (
      <a href={profileHref(author.username)} tabindex="-1">
        <Avatar class="size-10 text-xs" name={author.fullname} picture={author.profilePicture} />
      </a>
    )}
    <div class="min-w-0 flex-1">
      <p class="truncate font-semibold">
        {showAuthor && <a class="hover:underline" href={profileHref(author.username)}>{author.fullname}</a>}
        {showAuthor && showRestaurant && <span class="font-normal text-fg-muted"> on </span>}
        {showRestaurant && <a class="hover:underline" href={restaurantHref(restaurant.id)}>{restaurant.name}</a>}
      </p>
      <p class="t-body-sm flex flex-wrap items-center gap-x-2 text-fg-muted">
        <span class="inline-flex items-center gap-0.5 text-brand-text" role="img" aria-label={describeStars(toStars(review.rating))}>
          {starFills(review.rating).map((fill) => (
            <span class="grid *:col-start-1 *:row-start-1">
              <Star class:list={{ "text-line-strong": fill !== "full" }} size={15} fill="currentColor" aria-hidden="true" />
              {fill === "half" && <StarHalf size={15} fill="currentColor" aria-hidden="true" />}
            </span>
          ))}
        </span>
        <span class="flex gap-2 whitespace-nowrap">
          <span aria-hidden="true">·</span>
          <a class="hover:underline" href={reviewHref(review.id)}>
            <RelativeTime date={review.createdAt} />
          </a>
        </span>
        {canEdit && (
          <a class="inline-flex items-center gap-1 whitespace-nowrap hover:text-fg hover:underline" href={editReviewHref(review.id)}>
            <Pencil size={13} aria-hidden="true" />Edit<span class="sr-only"> review</span>
          </a>
        )}
      </p>
    </div>
    {!review.isListed && (
      <span class="tag mt-0.5" title="Only your three most recent reviews of a restaurant are public.">Hidden</span>
    )}
  </header>

  {review.description && <p class="t-body mt-2 max-w-prose whitespace-pre-line">{review.description}</p>}

  {review.pictures.length > 0 && (
    <ul class="mt-3 grid gap-1.5" style={pictureColumns}>
      {review.pictures.map((picture) => (
        <li>
          <a href={picture.url}>
            <img class="aspect-square w-full rounded-field bg-subtle object-cover" src={picture.url} alt="" loading="lazy" decoding="async" />
          </a>
        </li>
      ))}
    </ul>
  )}

  {(canLike || review.likeCount > 0) && (
    <footer class="mt-3 flex items-center gap-2">
      {canLike ? (
        <form class="flex" method="post" action={review.isLikedByViewer ? actions.reviews.unlike : actions.reviews.like}>
          <input type="hidden" name="reviewId" value={review.id} />
          <button class="btn btn-sm btn-secondary" type="submit" aria-pressed={review.isLikedByViewer ? "true" : "false"}>
            <Heart class:list={{ "text-danger": review.isLikedByViewer, "like-pop": justLiked }} size={16} fill={review.isLikedByViewer ? "currentColor" : "none"} aria-hidden="true" />
            <span class="sr-only">Like</span>
            <span class="tabular-nums">{review.likeCount}</span>
          </button>
        </form>
      ) : (
        review.likeCount > 0 && (
          <p class="t-body-sm flex items-center gap-1 text-fg-muted">
            <Heart size={16} aria-hidden="true" />
            {review.likeCount} {review.likeCount === 1 ? "like" : "likes"}
          </p>
        )
      )}
    </footer>
  )}
</article>
