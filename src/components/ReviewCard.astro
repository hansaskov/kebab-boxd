---
import { Heart, Pencil, Star, StarHalf } from "@lucide/astro";
import { actions } from "astro:actions";
import type { HTMLAttributes } from "astro/types";
import Avatar from "@src/components/Avatar.astro";
import { canOn, type Subject } from "@src/auth/permissions";
import type { ReviewCard } from "@src/db/queries/reviews";
import RelativeTime from "@src/components/RelativeTime.astro";
import { describeStars, splitStars, toStars } from "@src/format/rating";
import { editReviewHref, profileHref, restaurantHref, reviewHref } from "@src/hrefs";

interface Props extends HTMLAttributes<"article"> {
  review: ReviewCard;
  viewer: Subject;
  showAuthor?: boolean;
  showRestaurant?: boolean;
}

const { review, viewer, showAuthor = true, showRestaurant = true, class: className, ...props } = Astro.props;
const { author, restaurant } = review;

const canLike = canOn(viewer, "review:like", review) || (review.isLikedByViewer && canOn(viewer, "review:unlike", review));
const canEdit = canOn(viewer, "review:edit", review);
const stars = splitStars(review.rating);
---

<article class:list={["px-4 py-4", className]} {...props}>
  <header class="flex items-center gap-3">
    {showAuthor && (
      <a href={profileHref(author.username)} tabindex="-1">
        <Avatar class="size-9 text-xs" name={author.fullname} picture={author.profilePicture} />
      </a>
    )}
    <div class="min-w-0 flex-1">
      <p class="t-body-sm truncate">
        {showAuthor && <a class="font-semibold link-hover" href={profileHref(author.username)}>{author.fullname}</a>}
        {showAuthor && showRestaurant && <span class="text-fg-muted"> on </span>}
        {showRestaurant && <a class="field-label inline link-hover" href={restaurantHref(restaurant.id)}>{restaurant.name}</a>}
      </p>
      <a class="t-body-sm text-fg-muted link-hover" href={reviewHref(review.id)}>
        <RelativeTime class="t-body-sm shrink-0 text-fg-muted" date={review.createdAt} />
      </a>
    </div>
    {!review.isListed && (
      <span class="tag" title="Only your three most recent reviews of a restaurant are public.">Hidden</span>
    )}
  </header>

  <span
    class="mt-2 inline-flex items-center gap-0.5 text-brand-text"
    role="img"
    aria-label={describeStars(toStars(review.rating))}
  >
    {Array.from({ length: stars.full }, () => <Star size={16} fill="currentColor" aria-hidden="true" />)}
    {stars.half && <StarHalf size={16} fill="currentColor" aria-hidden="true" />}
  </span>
  {review.description && <p class="t-body mt-1 whitespace-pre-line">{review.description}</p>}

  {review.pictures.length > 0 && (
    <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
      {review.pictures.map((picture) => (
        <li>
          <a href={picture.url}>
            <img class="aspect-square w-full rounded-field bg-subtle object-cover" src={picture.url} alt="" loading="lazy" decoding="async" />
          </a>
        </li>
      ))}
    </ul>
  )}

  {(canLike || canEdit || review.likeCount > 0) && (
    <footer class="mt-3 flex items-center gap-2">
      {canLike ? (
        <form class="flex" method="post" action={review.isLikedByViewer ? actions.reviews.unlike : actions.reviews.like}>
          <input type="hidden" name="reviewId" value={review.id} />
          <button class="btn btn-sm btn-secondary" type="submit" aria-pressed={review.isLikedByViewer ? "true" : "false"}>
            <Heart class:list={{ "text-danger": review.isLikedByViewer }} size={16} fill={review.isLikedByViewer ? "currentColor" : "none"} aria-hidden="true" />
            <span class="sr-only">Like</span>
            <span class="tabular-nums">{review.likeCount}</span>
          </button>
        </form>
      ) : (
        review.likeCount > 0 && (
          <p class="t-body-sm flex items-center gap-1 text-fg-muted">
            <Heart size={16} aria-hidden="true" />
            {review.likeCount} {review.likeCount === 1 ? "like" : "likes"}
          </p>
        )
      )}
      {canEdit && (
        <a class="btn btn-sm btn-secondary" href={editReviewHref(review.id)}>
          <Pencil size={16} aria-hidden="true" />Edit
        </a>
      )}
    </footer>
  )}
</article>
