---
import { Check, X } from "@lucide/astro";
import { actions } from "astro:actions";
import type { HTMLAttributes } from "astro/types";
import type { RestaurantStatus } from "@src/db/schema";

interface Props extends HTMLAttributes<"div"> {
  restaurantId: number;
  status: RestaurantStatus;
}

const { restaurantId, status, class: className, ...props } = Astro.props;
---

<div class:list={["flex gap-2", className]} {...props}>
  {status !== "approved" && (
    <form method="post" action={actions.admin.approveRestaurant}>
      <input type="hidden" name="restaurantId" value={restaurantId} />
      <button class="btn btn-primary btn-sm" type="submit"><Check size={16} aria-hidden="true" />Approve</button>
    </form>
  )}
  {status !== "rejected" && (
    <form method="post" action={actions.admin.rejectRestaurant}>
      <input type="hidden" name="restaurantId" value={restaurantId} />
      <button class="btn btn-danger btn-sm" type="submit"><X size={16} aria-hidden="true" />Reject</button>
    </form>
  )}
</div>
