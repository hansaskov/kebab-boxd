---
import { Check, X } from "@lucide/astro";
import { actions } from "astro:actions";
import type { HTMLAttributes } from "astro/types";
import type { RestaurantStatus } from "@src/db/schema";

interface Props extends HTMLAttributes<"form"> {
  restaurantId: number;
  status: RestaurantStatus;
}

const { restaurantId, status, class: className, ...props } = Astro.props;
---

<form class:list={["flex gap-2", className]} method="post" action={actions.admin.decideRestaurants} {...props}>
  <input type="hidden" name="restaurantId" value={restaurantId} />
  {status !== "approved" && (
    <button class="btn btn-primary btn-sm" type="submit" name="status" value="approved"><Check size={16} aria-hidden="true" />Approve</button>
  )}
  {status !== "rejected" && (
    <button class="btn btn-danger btn-sm" type="submit" name="status" value="rejected"><X size={16} aria-hidden="true" />Reject</button>
  )}
</form>
