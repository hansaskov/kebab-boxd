---
import {
  defaultSidebarMenuSections,
  type SidebarMenuSection,
} from "@src/data/sidebar-menu-sections";

interface Props {
  sidebarMenuSections?: SidebarMenuSection[];
}

const { sidebarMenuSections = defaultSidebarMenuSections } = Astro.props;
const { pathname } = Astro.url;

// Links with a #fragment are never active: the fragment is client-side
// state and the browser already shows the user where they are.
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<div class="p-4">
  <a href="/" class="block text-xl font-bold tracking-tight">Kebab Boxd</a>
</div>

<nav class="flex-1 overflow-y-auto px-3 pb-3">
  <ul class="menu w-full gap-1">
    {
      sidebarMenuSections.map((section) => (
        <>
          <li class="menu-title">{section.title}</li>
          {section.items.map((item) => {
            const Icon = item.icon;
            const active = isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[{ "bg-base-100": active }]}
                  aria-current={active ? "page" : undefined}
                >
                  <Icon size={20} />
                  {item.name}
                </a>
              </li>
            );
          })}
        </>
      ))
    }
  </ul>
</nav>
