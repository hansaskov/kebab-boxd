---
import { defaultSidebarMenuSections, type SidebarMenuSection } from '@data/sidebar-menu-sections';

const pathname = Astro.url.pathname;

interface Props {
  sidebarMenuSections?: SidebarMenuSection[];
}

const { sidebarMenuSections = defaultSidebarMenuSections } = Astro.props;
---

<div class="p-4">
  <a href="/" class="block text-xl font-bold tracking-tight">Kebab Boxd</a>
</div>

<nav class="flex-1 overflow-y-auto px-3 pb-3">
  <ul class="menu gap-1 w-full">
    {
      sidebarMenuSections.map((s) => (
        <>
          <li class="menu-title">{s.title}</li>
          {s.items.map((t) => {
            const Icon = t.icon;
            return (
              <li>
                <a href={t.href} class:list={[(t.href === "/" ? pathname === "/" : pathname.startsWith(t.href)) && "bg-base-100"]}>
                  <Icon size={20} />
                  {t.name}
                </a>
              </li>
            );
          })}
        </>
      ))
    }
  </ul>
</nav>
