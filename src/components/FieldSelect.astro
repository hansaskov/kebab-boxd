---
import { getConstraintsFromZodSchmea } from "@src/validation/constraint";
import { ZodNullable, type ZodEnum } from "astro/zod";

interface Props extends astroHTML.JSX.SelectHTMLAttributes {
    zodField: ZodEnum | ZodNullable<ZodEnum>;
    selected?: string | undefined | null;
    title?: string;
    description: string;
    noneOption?: string;
    errors?: string[] | undefined; 
}

const props = Astro.props
const enumField = props.zodField instanceof ZodNullable
    ? props.zodField.unwrap()
    : props.zodField
const constraints = getConstraintsFromZodSchmea(props.zodField)
const options = enumField.options
const fieldId = props.id ?? props.name
---

<div class="settings-row">
    <div class="settings-row-text">
        <label class="field-label" for={fieldId}>{props.title}</label>
        <p class="t-body-sm text-fg-muted">{props.description}</p>
    </div>
    <div class="settings-row-field space-y-2">
        <select   
            id={fieldId}
            class:list={[
                "input",
                props.class
            ]}
            {...constraints}
            {...props}
        >
            {options.map(opt => (
                <option value={opt} selected={props.selected === opt}>{opt}</option>
            ))}
            {props.zodField instanceof ZodNullable && (
                <option value="" selected={props.selected == null}>{props.noneOption ?? "None"}</option>
            )}
        </select>
        {props.errors && (
            <p class="t-caption text-danger" role="alert">{props.errors.join("\n")}</p>
        )}
    </div>
</div>
