---
import { ChevronDown } from "@lucide/astro";
import type { ComponentProps } from "astro/types";
import { ZodNullable, type ZodEnum } from "astro/zod";
import Field from "@src/components/Field.astro";
import type { SubmittedForm } from "@src/actions/outcome";
import { describeField } from "@src/format/field";
import { getConstraintsFromZodSchema } from "@src/validation/constraint";

interface Props extends Omit<ComponentProps<typeof Field>, "field" | "layout">, astroHTML.JSX.SelectHTMLAttributes {
    name: string;
    zodField: ZodEnum | ZodNullable<ZodEnum>;
    label: string;
    selected?: string | undefined | null;
    noneOption?: string;
    // The form as the user sent it when it failed. What they chose replaces the selected option.
    submitted?: SubmittedForm | undefined;
}

const { zodField, selected, label, description, noneOption, submitted, class: className, ...props } = Astro.props;
const isNullable = zodField instanceof ZodNullable;
const options = (isNullable ? zodField.unwrap() : zodField).options;
const current = submitted ? submitted.get(props.name) || null : selected;
const field = describeField({ ...props, description, submitted });
---

<Field field={field} label={label} description={description}>
    <div class="select">
        <select class:list={["input", className]} {...getConstraintsFromZodSchema(zodField)} {...props} {...field.control}>
            {options.map((option) => <option value={option} selected={current === option}>{option}</option>)}
            {isNullable && <option value="" selected={current == null}>{noneOption ?? "None"}</option>}
        </select>
        <ChevronDown size={16} aria-hidden="true" class="select-icon" />
    </div>
</Field>
