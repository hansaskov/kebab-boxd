---
import { ChevronDown } from "@lucide/astro";
import { getConstraintsFromZodSchema } from "@src/validation/constraint";
import { ZodNullable, type ZodEnum } from "astro/zod";

interface Props extends astroHTML.JSX.SelectHTMLAttributes {
    name: string;
    zodField: ZodEnum | ZodNullable<ZodEnum>;
    selected?: string | undefined | null;
    label: string;
    description?: string;
    noneOption?: string;
    errors?: string[] | undefined;
}

const { zodField, selected, label, description, noneOption, errors, class: className, ...props } = Astro.props
const enumField = zodField instanceof ZodNullable
    ? zodField.unwrap()
    : zodField
const constraints = getConstraintsFromZodSchema(zodField)
const options = enumField.options
const fieldId = props.id ?? props.name
const descriptionId = `${fieldId}-description`
const errorId = `${fieldId}-error`
const hasErrors = errors !== undefined && errors.length > 0
const describedBy = [description && descriptionId, hasErrors && errorId].filter(Boolean).join(" ") || undefined
---

<div class="settings-row">
    <div class="settings-row-text">
        <label class="field-label" for={fieldId}>{label}</label>
        {description && <p id={descriptionId} class="t-body-sm text-fg-muted">{description}</p>}
    </div>
    <div class="settings-row-field space-y-2">
        <div class="select">
            <select
                id={fieldId}
                class:list={["input", className]}
                aria-describedby={describedBy}
                aria-invalid={hasErrors ? "true" : undefined}
                {...constraints}
                {...props}
            >
                {options.map(opt => (
                    <option value={opt} selected={selected === opt}>{opt}</option>
                ))}
                {zodField instanceof ZodNullable && (
                    <option value="" selected={selected == null}>{noneOption ?? "None"}</option>
                )}
            </select>
            <ChevronDown size={16} aria-hidden="true" class="select-icon" />
        </div>
        {hasErrors && (
            <p id={errorId} class="t-caption text-danger" role="alert">{errors.join(" ")}</p>
        )}
    </div>
</div>
