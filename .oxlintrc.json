{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    "src/tests/*"
  ],
  "rules": {
    "no-underscore-dangle": ["error", { "allow": ["_zod"] }],
    "no-restricted-imports": ["error", {
      "patterns": [{
        "group": ["drizzle-orm", "drizzle-orm/*"],
        "message": "Database access belongs in src/db. Add it to the module of its concept there and call it through Astro.locals.db."
      }]
    }]
  },
  "overrides": [
    {
      "files": ["src/db/**"],
      "rules": { "no-restricted-imports": "off" }
    }
  ],
  "env": {
    "builtin": true
  }
}
