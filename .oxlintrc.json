{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    "src/tests/*"
  ],
  "rules": {
    "no-underscore-dangle": ["error", { "allow": ["_zod"] }],
    "no-restricted-imports": ["error", {
      "patterns": [{
        "group": ["drizzle-orm", "drizzle-orm/*"],
        "message": "Database access belongs in src/db. Add it to the module of its concept there and call it through Astro.locals.db."
      }, {
        "group": ["@src/db/*", "!@src/db/problem", "!@src/db/remote"],
        "allowTypeImports": true,
        "message": "The Web Worker would load the code of the database and Drizzle with it. Import its types, or move the value to src/data."
      }]
    }]
  },
  "overrides": [
    {
      "files": ["src/db/**", "src/backend.ts", "src/background-work.ts", "tools/page-latency/**"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["sst.config.ts"],
      "rules": { "typescript/triple-slash-reference": "off" }
    }
  ],
  "env": {
    "builtin": true
  }
}
