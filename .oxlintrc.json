{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "jsPlugins": [
    "./tools/oxlint/comments.ts"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    "src/tests/*"
  ],
  "rules": {
    "comments/none": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_zod"
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "drizzle-orm",
              "drizzle-orm/*"
            ],
            "message": "Only the database uses Drizzle. Put the query in the .db.ts module of its feature and call it through Astro.locals.db."
          },
          {
            "group": [
              "@src/db",
              "@src/db/*",
              "@src/**/*.db",
              "!@src/db/problem",
              "!@src/db/remote"
            ],
            "allowTypeImports": true,
            "message": "The Web Worker would load the database and Drizzle with it. Import its types, or move the value to the .ts module beside the .db.ts one."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/**/*.db.ts",
        "src/db/**",
        "src/backend.ts",
        "src/background-work.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "astro",
                  "astro/*",
                  "astro:*",
                  "zod",
                  "zod/*",
                  "@lucide/*",
                  "@src/actions/*",
                  "@src/**/actions",
                  "@src/**/*.astro"
                ],
                "allowTypeImports": true,
                "message": "The Durable Object would load Astro and Zod, which only the pages and forms need. Move the value to a plain .ts module of its feature."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "tools/page-latency/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "sst-env.d.ts",
        ".drizzle/**"
      ],
      "rules": {
        "comments/none": "off"
      }
    },
    {
      "files": [
        "sst.config.ts"
      ],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
